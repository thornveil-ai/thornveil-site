---
import { ClientRouter } from 'astro:transitions';
import MomentumStrip from '../components/MomentumStrip.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import 'lenis/dist/lenis.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Thornveil | Sovereign AI infrastructure',
  description = Astro.url.pathname.replace(/\/$/, '') === '/privacy'
    ? 'How the Thornveil website handles analytics, third-party services, and email contact, with operational details pending confirmation.'
    : 'Ten engineering systems for sovereign federal AI infrastructure. IL5-ready, ECCN-aware, governance-first. Built solo while active-duty USMC. Direct contracts open December 10, 2026.',
  ogImage = '/og-image.jpg',
} = Astro.props;

// Static directory routes use the same trailing slash as the generated sitemap.
const pathname = Astro.url.pathname;
const canonicalPath = pathname.replace(/\/$/, '') === '/404' ? '/404.html'
  : pathname.endsWith('/') || /\.[^/]+$/.test(pathname) ? pathname : `${pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en" class="no-transitions">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#060A12" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Declared dimensions match the actual PNG files. -->
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    {ogImage === '/og-image.jpg' && <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Thornveil — Built at the Edge" />
    </>}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    {ogImage === '/og-image.jpg' && <meta name="twitter:image:alt" content="Thornveil — Built at the Edge" />}

    <!-- Fonts: Archivo (variable, wdth+wght axes for Expanded headlines) + IBM Plex Mono.
         Ital axis dropped — no italics in use. Cuts payload. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <!-- Astro 5 view transitions: cohesive single-document navigation, no SPA cost. -->
    <ClientRouter />

    <!-- Plausible Analytics (privacy-respecting, no cookies, GDPR-clean) -->
    <script defer data-domain="thornveil.ai" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Subtle film-grain noise overlay — instrument-grade texture, ~3% opacity -->
    <div class="noise-overlay" aria-hidden="true">
      <svg width="100%" height="100%">
        <filter id="noiseFilter">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
          <feColorMatrix values="0 0 0 0 0.91  0 0 0 0 0.92  0 0 0 0 0.93  0 0 0 0.5 0" />
        </filter>
        <rect width="100%" height="100%" filter="url(#noiseFilter)" />
      </svg>
    </div>

    <MomentumStrip />
    <Nav />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // View transitions: the script runs on initial document load *and* on every
      // astro:page-load event, so reveal handlers are wired up after each nav.
      function bindRevealObserver() {
        // Allow CSS transitions only after first paint to avoid initial-load flashes.
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove('no-transitions');
          });
        });

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) {
          document.querySelectorAll('.reveal, .line-reveal').forEach((el) => el.classList.add('visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal:not(.visible), .line-reveal:not(.visible)').forEach((el) => observer.observe(el));
      }

      bindRevealObserver();
      document.addEventListener('astro:page-load', bindRevealObserver);

      // Magnetic buttons — signature interaction.
      // When the cursor approaches a .tv-btn within MAG_RADIUS, the button
      // translates a few pixels toward the cursor. Sub-perceptual polish
      // that Stripe/Linear/Vercel get right. Disabled on reduced-motion + touch.
      const MAG_RADIUS = 90;
      const MAG_PULL = 8;

      let cleanupMagnetic = () => {};
      function bindMagneticButtons() {
        cleanupMagnetic();
        const controller = new AbortController();
        const { signal } = controller;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        const coarse = window.matchMedia('(hover: none), (pointer: coarse)');
        const buttons = document.querySelectorAll('.tv-btn');
        const original = new Map(Array.from(buttons, (button) => [
          button, { transform: button.style.transform, transition: button.style.transition },
        ]));
        function reset() {
          cancelAnimationFrame(raf);
          raf = 0;
          buttons.forEach((button) => {
            const styles = original.get(button);
            button.style.transform = styles.transform;
            button.style.transition = styles.transition;
          });
        }

        let raf = 0;
        let mouseX = -9999, mouseY = -9999;
        window.addEventListener('pointermove', (e) => {
          if (reduce.matches || coarse.matches || e.pointerType !== 'mouse') {
            reset();
            return;
          }
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (!raf) raf = requestAnimationFrame(tick);
        }, { passive: true, signal });
        document.documentElement.addEventListener('pointerleave', reset, { signal });
        window.addEventListener('blur', reset, { signal });
        window.addEventListener('scroll', reset, { passive: true, signal });
        document.addEventListener('visibilitychange', reset, { signal });
        reduce.addEventListener('change', reset, { signal });
        coarse.addEventListener('change', reset, { signal });
        cleanupMagnetic = () => { controller.abort(); reset(); };

        function tick() {
          raf = 0;
          buttons.forEach((btn) => {
            const r = btn.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            const dx = mouseX - cx;
            const dy = mouseY - cy;
            const dist = Math.hypot(dx, dy);
            if (Number.isFinite(dist) && dist > 0 && dist < MAG_RADIUS) {
              const pull = (1 - dist / MAG_RADIUS) * MAG_PULL;
              const tx = (dx / dist) * pull;
              const ty = (dy / dist) * pull;
              btn.style.transform = `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px)`;
              btn.style.transition = 'transform 0ms';
            } else if (btn.style.transform) {
              btn.style.transform = original.get(btn).transform;
              btn.style.transition = original.get(btn).transition;
            }
          });
        }
      }

      bindMagneticButtons();
      document.addEventListener('astro:page-load', bindMagneticButtons);
      document.addEventListener('astro:before-swap', () => cleanupMagnetic());
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 10000;
        padding: 0.75rem 1rem;
        color: #fff;
        background: #060a12;
        border: 2px solid currentColor;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }
      main { scroll-margin-top: 7rem; }
    </style>

    <style is:global>
      .noise-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        opacity: 0.025;
        mix-blend-mode: overlay;
      }
      @media (prefers-reduced-motion: reduce) {
        .noise-overlay { opacity: 0.015; }
      }
    </style>
  </body>
</html>
