---
import BaseLayout from '../layouts/BaseLayout.astro';
import metrics from '../data/metrics.json';
const m = metrics;

// 10-system portfolio, restricted to systems with direct defense-procurement adjacency.
const systems = [
  {
    name: 'Mycelium',
    tagline: 'Distributed AI mesh. Substitute-on-failure inference.',
    description: 'Six workers pool compute for one Gemma-4-26B chat. When workers drop, substitute-on-failure dispatch keeps generation continuing — validated end-to-end on 2026-05-08 with HMAC-chained tamper-evident audit log. Built for DDIL operational environments where any individual node may go dark and the workload must continue.',
    programFit: 'SOCPAC R2I/MOSA · DDIL operations · IL5-pathway inference',
    status: 'live', statusLabel: 'v1.0.0 · evaluator outreach in motion',
    overview: 'https://github.com/thornveil-ai/mycelium-overview',
    detail: '/mycelium',
  },
  {
    name: 'Auspex',
    tagline: 'AI red team gated by Signet. EAR ECCN 4D004.',
    description: 'Scope-as-code engagement compilation. 13 standard authority checks at the Signet gate. HMAC-chained per-engagement audit log with RFC 3161 trusted-timestamp anchoring. Validated end-to-end on autonomous Active Directory takeover with auditable replay package (2026-05-16). Federal-gated.',
    programFit: 'USAISI evaluator pipeline · USCYBERCOM red team · Federal autonomous-cyber pilots',
    status: 'live', statusLabel: 'v0.5.3 federal edition',
    overview: 'https://github.com/thornveil-ai/auspex-contact',
    detail: null,
  },
  {
    name: 'RigRun',
    tagline: 'Professional AI chat. Classification-gated routing.',
    description: 'Three apps (desktop, mobile, web) on one Go backend. 44 NIST 800-53 controls implemented as discrete code paths. The type system excludes cloud routing for CUI+ queries. 6,950 tests across the three apps. IL5-pathway posture. ATO sponsor outreach active post-DD-214.',
    programFit: 'IL5-pathway federal AI chat · FedRAMP-Mod path · NIST 800-53 / IR-9 spillage detection',
    status: 'live', statusLabel: 'v0.9 · federal evaluation',
    overview: 'https://github.com/thornveil-ai/rigrun-overview',
    detail: null,
  },
  {
    name: 'HawkStack',
    tagline: 'Sub-million-parameter perception across 5 domains.',
    description: 'Topology-driven recipe that turns (dataset, domain) into (architecture, training config) and produces models that match SOTA in their weight class. 15 verified zoo checkpoints across IRST, sonar, PCB defect, histopathology, thermal drone, and ECG. 16-run power-law scaling fit on NUDT-SIRST (R²=0.9895). Topology paper preparing arXiv submission.',
    programFit: 'Replicator · Roadrunner-M · Coyote Block 3 · Army LIDS / FS-LIDS · NAVSEA USV-counter-USV',
    status: 'warn', statusLabel: 'v0.3.0 · arXiv preparing',
    overview: 'https://github.com/thornveil-ai/hawkstack-paper',
    detail: null,
  },
  {
    name: 'Meridian',
    tagline: 'Memory-safe Rust flight-control firmware.',
    description: 'From-scratch ArduPilot/PX4 alternative on STM32 H7 / F4 / F7. 98K Rust LOC across 60 lib crates + 3 binaries. Phase 10 trade-secret primitives — ed25519-signed airworthiness attestation, RC hijack / GPS spoof / mag jam adversarial-detection failsafes, Find My Drone beacon, self-learning vehicle dynamics ID, Black Box event taxonomy — that no other autopilot ships. ~29K lines of parity-audit notes against 154 ArduPilot libraries (47K total documentation). H7 firmware flying; F4/F7 board configs staged. Hardware bring-up active on MatekH743 SLIM V4 and Cube Orange Plus.',
    programFit: 'CISA memory-safe roadmap · DoD CIO memory-safe mandate · DARPA HACMS successor · SOCOM USV firmware · FAA certification path',
    status: 'live', statusLabel: 'hardware bring-up active',
    overview: 'https://github.com/thornveil-ai/meridian-core',
    detail: null,
  },
  {
    name: 'Canopy',
    tagline: 'Multi-modal counter-UAS situational awareness.',
    description: 'RF + acoustic + thermal + Remote ID + ADS-B fusion. Kalman tracking, Dempster-Shafer evidence fusion and bearing-intersection geolocation have been tested. With mesh networking and the decision engine scaffolded and ML classifiers still stubbed, this Phase 0 project is intended to replace DragonOS/WarDragon with an open architecture that supports mesh networking. Hardware tiers from $270 (Pi 5 + RTL-SDR) to $1,650 (KrakenSDR + UCA DF).',
    programFit: 'DHS/CBP border CUAS · FAA Section 2209 · 14 CFR Part 89 Remote ID enforcement',
    status: 'warn', statusLabel: 'Phase 0 · architecture validated',
    overview: 'https://github.com/thornveil-ai/canopy-preview',
    detail: null,
  },
  {
    name: 'Signet',
    tagline: 'Capability-based safety gate for LLM agents.',
    description: '4-stage check pipeline (ADMISSION / INSPECTION / COMMITMENT / RECORD) with 11 production checks and HMAC-chained tamper-evident audit log. RFC 3161 anchor backend (FreeTSA / DigiCert). Auspex extends Signet\'s check vocabulary with checks specific to each engagement. Apache-2.0 public OSS. Available on PyPI as `signet-sign`.',
    programFit: 'NIST AI RMF · DoD AISI baseline · Federal LLM-agent safety reference',
    status: 'live', statusLabel: 'v0.1.10.1 · Apache-2.0 OSS',
    overview: 'https://github.com/thornveil-ai/signet',
    detail: null,
  },
];

const posture = [
  { label: 'Engagement now',         value: 'Evaluation NDA · replay package · walkthrough' },
  { label: 'Direct contracts',       value: `${m.company.directContractsOpen}` },
  { label: 'Data rights posture',    value: 'Commercial item (FAR 12.212 / DFARS 252.227-7015)' },
  { label: 'Planned vehicles',       value: 'Direct contract · SBIR Phase I/II · OTA · CRADA · GSA/SEWP' },
  { label: 'Federal registration',   value: 'SAM.gov active (All Awards) · UEI NCBZNKMJBP59 · CAGE 1T0K4' },
  { label: 'Founder posture',        value: 'Active-duty USMC · conversations compound to signed paper' },
];
---

<BaseLayout
  title="Defense | Thornveil"
  description="Seven of Thornveil's ten systems address concrete federal program-of-record adjacency: SOCPAC R2I, USAISI, FedRAMP-Mod, Replicator, FS-LIDS, NAVSEA USV-counter-USV, DARPA HACMS-aligned memory safety, FAA Section 2209."
>
  <!-- HERO -->
  <section class="tv-section pt-s-11">
    <div class="tv-container">
      <h1 class="tv-h1 mt-s-3 reveal reveal-delay-1" style="max-width: 22ch;">
        Cleared for the next federal procurement window.
      </h1>
      <p class="text-step-1 text-text-2 mt-s-5 reveal reveal-delay-2" style="max-width: 64ch;">
        Seven of Thornveil's ten systems are directly defense-procurement adjacent. Each is built ground-up
        to clear FedRAMP, IL5, or ECCN review on day one — not retrofitted after the customer asks.
        Evaluation engagements active now; direct contracts open {m.company.directContractsOpen}.
      </p>
    </div>
  </section>

  <nav class="tv-section pt-0 defense-local-nav" aria-label="On this page">
    <div class="tv-container">
      <div class="defense-local-nav__inner">
        <span class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">On this page</span>
        <div class="defense-local-nav__links">
          <a href="#systems">Systems</a>
          <a href="#procurement-posture">Procurement posture</a>
          <a href="#defense-contact">Contact</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- SYSTEMS LIST -->
  <section id="systems" class="tv-section pt-0" aria-labelledby="systems-heading" tabindex="-1">
    <div class="tv-container">
      <h2 id="systems-heading" class="sr-only">Defense-adjacent systems</h2>
      <div class="space-y-s-5">
        {systems.map((s, i) => (
          <article class={`tv-tile reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <div class="flex items-start justify-between gap-s-4 flex-wrap mb-s-4">
              <div class="flex-1 min-w-0">
                <h3 class="text-step-2 defense-system-name" style="font-variation-settings: 'wdth' 125;">{s.name}</h3>
                <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-2">{s.tagline}</p>
              </div>
              <span class={`tv-pill ${s.status === 'live' ? 'tv-pill--live' : 'tv-pill--warn'} shrink-0`}>
                {s.statusLabel}
              </span>
            </div>
            <p class="text-step-0 text-text-2 mb-s-5 max-w-prose">{s.description}</p>
            <div class="border-t border-line pt-s-4 grid grid-cols-1 md:grid-cols-3 gap-s-4">
              <div class="md:col-span-2">
                <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mb-s-2">Program fit</p>
                <p class="text-step-0 text-text-2">{s.programFit}</p>
              </div>
              <div class="flex md:justify-end items-end gap-s-3 flex-wrap">
                {s.detail ? (
                  <a href={s.detail} class="tv-btn tv-btn--primary" style="padding: var(--s-2) var(--s-4);">Mycelium mechanism and test status</a>
                ) : null}
                {s.overview ? (
                  <a href={s.overview} target="_blank" rel="noopener" class="tv-btn tv-btn--secondary" style="padding: var(--s-2) var(--s-4);">
                    Public companion ↗
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCUREMENT POSTURE -->
  <section id="procurement-posture" class="tv-section pt-0" aria-labelledby="procurement-heading" tabindex="-1">
    <div class="tv-container max-w-4xl">
      <h2 id="procurement-heading" class="tv-h2 mt-s-3 mb-s-6 reveal reveal-delay-1">What's available, and when.</h2>
      <div class="tv-tile reveal reveal-delay-2">
        <dl class="space-y-s-4">
          {posture.map((p) => (
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-s-2 pb-s-3 border-b border-line last:border-0 last:pb-0">
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">{p.label}</dt>
              <dd class="text-step-0 text-text defense-posture-value">{p.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="defense-contact" class="tv-section pt-0" aria-labelledby="defense-contact-heading" tabindex="-1">
    <div class="tv-container max-w-2xl text-center">
      <h2 id="defense-contact-heading" class="tv-h2 mt-s-3 reveal reveal-delay-1">Federal program offices, primes, evaluators.</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
        Conversations now compound into signed paper post-DD-214 ({m.company.directContractsOpen}).
        Review the public companions; the substrate is ready.
      </p>
      <div class="mt-s-7 flex flex-wrap gap-s-3 justify-center reveal reveal-delay-3">
        <a href="mailto:jesse@thornveil.ai?subject=Defense%20inquiry" class="tv-btn tv-btn--primary">
          jesse@thornveil.ai
        </a>
        <a href="/cofounder" class="tv-btn tv-btn--secondary">Co-founder profile →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .defense-local-nav {
    padding-bottom: var(--s-5);
  }

  .defense-local-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .defense-local-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
  }

  .defense-local-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.35em;
  }

  .defense-local-nav a:hover,
  .defense-local-nav a:focus-visible {
    color: var(--signal-text);
    text-decoration-color: currentColor;
  }

  h1, h2, p, .tv-btn, .tv-pill,
  .defense-system-name,
  .defense-posture-value {
    overflow-wrap: anywhere;
  }
  .tv-pill { white-space: normal; max-width: 100%; }
  .tv-tile, .tv-tile > div { min-width: 0; }

  @media (max-width: 40rem) {
    .defense-local-nav__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--s-2);
    }
  }
</style>
