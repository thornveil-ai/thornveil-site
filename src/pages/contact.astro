---
import BaseLayout from '../layouts/BaseLayout.astro';
import metrics from '../data/metrics.json';
const m = metrics;
---

<BaseLayout
  title="Contact | Thornveil"
  description="Direct line to Jesse Morgan. Federal program offices, defense primes, evaluators, prospective co-founders. Direct contracts open December 10, 2026."
>
  <!-- HERO -->
  <section class="tv-section pt-s-11">
    <div class="tv-container max-w-3xl text-center">
      <h1 class="tv-h1 mt-s-3 mx-auto reveal reveal-delay-1">Inquiries welcome.</h1>
      <p class="text-step-1 text-text-2 mt-s-5 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
        Federal program offices, defense primes, evaluators, prospective co-founders — direct line.
        Direct contracts open {m.company.directContractsOpen} (DD-214). Conversations welcome now.
      </p>

      <div class="mt-s-7 reveal reveal-delay-3">
        <a href="mailto:jesse@thornveil.ai" class="tv-btn tv-btn--primary text-step-0" style="padding: var(--s-4) var(--s-6);">
          jesse@thornveil.ai
        </a>
        <p class="text-step-0 text-text-2 mt-s-3">
          Opens your email app. Write and send your message there; this site has no contact form
          or automatic booking. If no app opens, copy jesse@thornveil.ai into your usual email service.
        </p>
        <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-3">
          Typical response within 24 hours.
        </p>
      </div>

      <div class="mt-s-6 flex flex-wrap justify-center gap-s-5 reveal reveal-delay-3">
        <a href="https://www.linkedin.com/company/thornveil-llc" target="_blank" rel="noopener" class="tv-nav-link">LinkedIn — Thornveil ↗</a>
        <a href="https://www.linkedin.com/in/jeranaias/" target="_blank" rel="noopener" class="tv-nav-link">LinkedIn — Jesse ↗</a>
        <a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="tv-nav-link">GitHub — thornveil-ai ↗</a>
      </div>
    </div>
  </section>

  <!-- TWO CARDS -->
  <section class="tv-section pt-0">
    <div class="tv-container max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-5">
        <div class="tv-tile reveal">
          <dl class="space-y-s-4 text-step-0 text-text-2">
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Federal evaluator</dt>
              <dd>30-min walkthrough · public companion repo access · evaluation NDA on request</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Prime / SI</dt>
              <dd>Program-fit brief · IP-license framework · teaming sketch</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Cyber operator</dt>
              <dd><a href="/cofounder" class="text-signal-text underline underline-offset-4 decoration-1">Co-founder profile</a> · substrate verification · unfiltered conversation</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Press / analyst</dt>
              <dd>Federal-AI capability questions answered in plain English. Use the email address above.</dd>
            </div>
          </dl>
        </div>

        <div class="tv-tile reveal reveal-delay-1">
          <dl class="space-y-s-4 text-step-0 text-text-2">
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Entity</dt>
              <dd>{m.company.name}</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Location</dt>
              <dd>{m.company.city}</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">NAICS</dt>
              <dd class="font-mono tabular">{m.company.naics.join(', ')}</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Founder availability</dt>
              <dd>Active-duty USMC; DD-214 {m.company.directContractsOpen}</dd>
            </div>
            <div>
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Org page</dt>
              <dd><a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="text-signal-text underline underline-offset-4 decoration-1">github.com/thornveil-ai</a></dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- ACQUISITION POSTURE -->
      <div class="tv-tile mt-s-5 reveal reveal-delay-2">
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-s-4 text-step-0 text-text-2">
          <div>
            <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Direct contract availability</dt>
            <dd>{m.company.directContractsOpen} (post-DD-214)</dd>
          </div>
          <div>
            <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">UEI / CAGE</dt>
            <dd class="font-mono tabular">NCBZNKMJBP59 · 1T0K4</dd>
          </div>
          <div>
            <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">SAM.gov</dt>
            <dd>Active · All Awards</dd>
          </div>
          <div>
            <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Data rights posture</dt>
            <dd>Commercial item (FAR 12.212 / DFARS 252.227-7015)</dd>
          </div>
          <div class="md:col-span-2">
            <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">Planned vehicles</dt>
            <dd>Direct contract · SBIR Phase I/II · OTA · CRADA · GSA/SEWP pursuit</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
