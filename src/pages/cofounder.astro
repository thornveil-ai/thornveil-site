---
import BaseLayout from '../layouts/BaseLayout.astro';
import metrics from '../data/metrics.json';
const m = metrics;

const requiredQuals = [
  'Roughly 8+ years operational experience at one of: MARFORCYBER, USCYBERCOM (J3), NSA TAO, IC red team, FBI Cyber Division, USAF 24th MOS, or peer organization. Senior NCO or O-grade typical; exceptional shorter-tenured candidates considered.',
  'Active TS/SCI clearance, or recent eligibility within the last 24 months. SCI-eligible at minimum.',
  'Post-uniform experience at a defense-AI startup (founding employee or early hire), fractional CRO/CSO across multiple defense AI startups, or corporate development at a defense prime\'s AI division (Booz Allen, SAIC, Leidos, GDIT, MITRE). Equivalent experience considered.',
  'At least one closed federal AI contract (won or lost) under FedRAMP, IL5, or ECCN scrutiny. You can articulate exactly why the outcome happened and what you would do differently.',
  'Material federal Rolodex: program-office contacts who will answer when you call, distributed across some combination of SOCOM, USCYBERCOM, DARPA (I2O preferred), AFRL, AvMC, NSA, CISA, or USAISI.',
  'Proven ability to translate technical capability into procurement-language wins. Comfortable with SBIR, OTA, BAA, CSO, CRADA, IDIQ.',
];

const preferredQuals = [
  'Direct experience as buyer or seller in AI red team programs (relevant to Auspex).',
  'Familiarity with R2I / MOSA compliance frameworks.',
  'Prior pre-seed or seed-stage co-founder experience.',
  'Working knowledge of one or more program offices: Replicator, FS-LIDS, NAVSEA USV-counter-USV, SOCPAC R2I, or USAISI evaluator pipeline.',
  'Operator-side credibility in adversarial AI safety (red team, threat hunt, capability evaluation).',
  'Federal acquisition certification (FAC-C, DAWIA Level II+) is a plus, not required.',
];

const responsibilities = [
  'Land 2-4 signed federal pilots across the IL5 trio (Auspex / Mycelium / RigRun) over the first 12 months post-DD-214.',
  'Build a customer board of 5-8 program-office relationships that do not depend on the founder being in the room.',
  'Navigate IL5 / FedRAMP-Mod / ECCN authorization cycles with the right sponsor at each step.',
  'Set commercial vs federal portfolio strategy across the broader 10-system portfolio.',
  'Lead procurement-vehicle selection per opportunity (SBIR Phase I/II/III, OTA, BAA, CSO, CRADA, IDIQ).',
  'Recruit operator-credibility hires when they are needed. Likely first hire: Director of Federal Sales or COO at the 18-month mark.',
];

const substrate = [
  { name: 'Auspex',   blurb: 'Federal-gated. Single-page public contact. Replay package available under evaluation NDA. Scope-as-code + 13-check Signet gate + HMAC-chained per-engagement audit.',                                                                                                                                                                                                                                pill: 'EAR ECCN 4D004', href: 'https://github.com/thornveil-ai/auspex-contact' },
  { name: 'Mycelium', blurb: 'R2I-aligned MOSA surface. NIST 800-53 mapped. 50-endpoint OpenAPI 3.1 published. Day-27 cryptographic reduction-to-practice with HMAC-chained tamper-evident audit log.',                                                                                                                                                                                                                          pill: 'v1.0.0 · cosign-signed', href: 'https://github.com/thornveil-ai/mycelium-overview' },
  { name: 'RigRun',   blurb: 'Three apps (desktop, mobile, web) on one Go backend. 44 NIST 800-53 controls implemented as discrete code paths. CUI+ hard-blocked from cloud routing at the compiler, not at runtime policy.',                                                                                                                                                                                                    pill: '496K LOC · 6,950 tests', href: 'https://github.com/thornveil-ai/rigrun-overview' },
  { name: 'Signet',   blurb: 'The vocabulary Auspex extends. 4-stage check pipeline. 11 production checks. HMAC-chained audit log. RFC 3161 trusted-timestamp anchoring. Public bug-hunt log documenting every cycle.',                                                                                                                                                                                                          pill: 'PyPI public OSS', href: 'https://github.com/thornveil-ai/signet' },
];

const terms = [
  { label: 'Equity',            value: 'Single-digit-percentage co-founder stake, vested 4 years with 1-year cliff. Pilot-conversion accelerators on top.' },
  { label: 'Title',             value: 'Co-founder. Functional title (President / COO / Chief Federal Officer) tailored to background.' },
  { label: 'Cash compensation', value: 'Pre-pilot: $0 base, founder-stage. Step-up trigger tied to first signed federal pilot.' },
  { label: 'Work model',        value: 'Remote-primary. Regular travel to program offices (SOCOM / MacDill is local to HQ).' },
  { label: 'Start date',        value: 'In position by Q1 2027 to align with FY27 federal-pilot procurement cycle.' },
  { label: 'Funding posture',   value: 'Not raising. Path to revenue via federal pilots, not VC.' },
];

const meta = [
  { label: 'Company',  value: m.company.name },
  { label: 'Location', value: 'Tampa, FL / Remote' },
  { label: 'Stage',    value: 'Pre-revenue · founder-led' },
  { label: 'Start',    value: 'By Q1 2027' },
];
---

<BaseLayout
  title="Co-founder, Federal Sales | Thornveil"
  description="Thornveil LLC is hiring a co-founder to run the federal sales motion for a 10-system defense-AI portfolio. Senior offensive cyber operator with post-uniform defense-AI startup experience."
>
  <!-- HERO / JOB HEADER -->
  <section class="tv-section pt-s-11 cofounder-hero">
    <div class="tv-container max-w-4xl">
      <div class="flex items-center gap-s-3 mb-s-5 flex-wrap reveal">
        <span class="tv-pill tv-pill--live">
          <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: var(--signal); box-shadow: 0 0 8px var(--signal);"></span>
          Open
        </span>
        <span class="tv-pill tv-pill--ghost">Single seat</span>
        <span class="tv-pill tv-pill--ghost">Federal sales lead</span>
      </div>

      <h1 class="tv-h1 reveal reveal-delay-1" style="max-width: 22ch;">Co-founder, federal sales.</h1>
      <p class="text-step-1 text-text-2 mt-s-5 reveal reveal-delay-2" style="max-width: 64ch;">
        Lead federal sales for the IL5 sovereign AI stack. Material co-founder equity. Pre-revenue.
        Technical substrate already shipped.
      </p>

      <div class="mt-s-7 flex flex-wrap gap-s-3 reveal reveal-delay-4">
        <a href="#apply" class="tv-btn tv-btn--primary">Apply →</a>
        <a href="#substrate" class="tv-btn tv-btn--secondary">Verify the substrate first</a>
      </div>

      <dl class="mt-s-7 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-s-3 reveal reveal-delay-3">
        {meta.map((p) => (
          <div class="tv-tile" style="padding: var(--s-4);">
            <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">{p.label}</dt>
            <dd class="text-step-0 text-text mt-s-2">{p.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ONE-LINE WEDGE -->
  <section class="tv-section pt-0">
    <div class="tv-container max-w-3xl">
      <p class="text-step-1 text-text-2 reveal reveal-delay-1">
        I've built ten engineering systems solo. I'm looking for a cofounder to lead federal sales.
      </p>
    </div>
  </section>

  <!-- VERIFY THE SUBSTRATE -->
  <section id="substrate" class="tv-section pt-0">
    <div class="tv-container max-w-4xl">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Pull a repo. Read the source.</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mb-s-6 reveal reveal-delay-2" style="max-width: 64ch;">
        Review the public companion repositories before deciding whether to join.
      </p>
      <div class="space-y-s-3">
        {substrate.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="tv-tile flex items-start gap-s-4 flex-wrap">
            <div class="flex-1 min-w-0">
              <h3 class="text-step-1 text-text" style="font-variation-settings: 'wdth' 125;">{s.name}</h3>
              <p class="text-step-0 text-text-2 mt-s-2 max-w-prose">{s.blurb}</p>
            </div>
            <span class="tv-pill tv-pill--live shrink-0">{s.pill}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- RESPONSIBILITIES -->
  <section class="tv-section pt-0" style="background: var(--bg-raised); border-top: 1px solid var(--line);">
    <div class="tv-container max-w-4xl">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Responsibilities</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mb-s-6 reveal reveal-delay-2" style="max-width: 64ch;">
        You are the second co-founder. You own the federal sales motion end-to-end.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-4 reveal reveal-delay-2">
        {responsibilities.map((r, i) => (
          <div class="tv-tile flex items-start gap-s-4">
            <span class="font-mono tabular text-step-2 text-signal-text shrink-0 leading-none">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-step-0 text-text-2">{r}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUALIFICATIONS — required + preferred merged into a single section -->
  <section class="tv-section pt-0">
    <div class="tv-container max-w-4xl">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Who fits.</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mb-s-6 reveal reveal-delay-2" style="max-width: 64ch;">
        Start with the required qualifications. The preferred list describes additional experience we'd value.
        If you're within striking distance of most of the
        required list, write anyway — exceptions are made for material edges we didn't anticipate.
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-s-5">
        <div class="tv-tile reveal reveal-delay-2" style="border-left: 2px solid var(--signal);">
          <p class="font-mono text-step--1 tracking-[0.18em] uppercase text-signal-text mb-s-4">Required</p>
          <ul class="space-y-s-4 text-step-0 text-text-2">
            {requiredQuals.map((q) => (
              <li class="flex gap-s-3">
                <span class="font-mono text-signal-text shrink-0" aria-hidden="true">✓</span>
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="tv-tile reveal reveal-delay-3">
          <p class="font-mono text-step--1 tracking-[0.18em] uppercase text-text-3 mb-s-4">Preferred</p>
          <ul class="space-y-s-3 text-step-0 text-text-2">
            {preferredQuals.map((q) => (
              <li class="flex gap-s-3">
                <span class="font-mono text-text-3 shrink-0" aria-hidden="true">+</span>
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TERMS -->
  <section class="tv-section pt-0" style="background: var(--bg-raised); border-top: 1px solid var(--line);">
    <div class="tv-container max-w-4xl">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">What the seat looks like</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-4 mt-s-6 reveal reveal-delay-2">
        {terms.map((t) => (
          <div class="tv-tile" style="border-top: 2px solid var(--signal);">
            <p class="font-mono text-step--1 tracking-[0.12em] uppercase text-signal-text mb-s-2">{t.label}</p>
            <p class="text-step-0 text-text-2">{t.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- (Founder bio lives on the homepage FounderCard + /about page; not repeated here.) -->

  <!-- APPLY -->
  <section id="apply" class="tv-section pt-0" style="background: var(--bg-inset); border-top: 1px solid var(--line);">
    <div class="tv-container max-w-3xl">
      <div class="text-center">
        <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Send the email.</h2>
      </div>

      <div class="text-center mt-s-6 reveal reveal-delay-2">
        <a href="mailto:jesse@thornveil.ai?subject=Co-founder%20application" aria-label="Email jesse@thornveil.ai to apply as co-founder" class="tv-btn tv-btn--primary text-step-0 cofounder-email" style="padding: var(--s-4) var(--s-7);">
          jesse@thornveil.ai
        </a>
        <p class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3 mt-s-3">
          Subject: Co-founder application
        </p>
      </div>

      <div class="tv-tile mt-s-9 reveal reveal-delay-3">
        <ol class="space-y-s-5 text-step-0 text-text-2">
          <li class="flex gap-s-4">
            <span class="font-mono tabular text-step-2 text-signal-text shrink-0 leading-none">01</span>
            <span class="pt-s-1">The federal programs you have worked, and on which side of the table.</span>
          </li>
          <li class="flex gap-s-4">
            <span class="font-mono tabular text-step-2 text-signal-text shrink-0 leading-none">02</span>
            <span class="pt-s-1">One customer relationship you would convert in the first 90 days, and which Thornveil system you would lead with.</span>
          </li>
          <li class="flex gap-s-4">
            <span class="font-mono tabular text-step-2 text-signal-text shrink-0 leading-none">03</span>
            <span class="pt-s-1">One thing in this job description that gave you pause, and how you would address it if hired.</span>
          </li>
        </ol>
        <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-5">
          1–2 paragraphs is plenty. No resume needed at first contact.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-4 mt-s-5 reveal reveal-delay-4">
        <div class="tv-tile">
          <p class="font-mono text-step--1 tracking-[0.12em] uppercase text-signal-text mb-s-2">Response timeline</p>
          <p class="text-step-0 text-text-2">Responses within 48 hours. Initial conversation is a 30-min call. Target first contact to handshake: 4–6 weeks.</p>
        </div>
        <div class="tv-tile">
          <p class="font-mono text-step--1 tracking-[0.12em] uppercase text-signal-text mb-s-2">Equal opportunity</p>
          <p class="text-step-0 text-text-2">Thornveil LLC is an equal-opportunity employer. Selection is based on qualifications, fit, and ability to execute the role.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

<style>
  .cofounder-hero dt { color: var(--text-2); }
  .cofounder-hero .tv-btn,
  .cofounder-email {
    min-height: 44px;
    justify-content: center;
    white-space: normal;
    text-align: center;
  }

  .cofounder-email {
    text-transform: none;
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
  }

  .tv-tile {
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    #substrate .tv-tile { flex-direction: column; }
    #substrate .tv-pill { max-width: 100%; white-space: normal; }
    .cofounder-hero {
      padding-top: 48px;
      padding-bottom: 56px;
    }

    .cofounder-hero .tv-h1 {
      font-size: clamp(2.3rem, 11.5vw, 2.65rem);
      line-height: 1.08;
      overflow-wrap: anywhere;
    }

    .tv-h2 {
      font-size: clamp(1.72rem, 8vw, 2.15rem);
      line-height: 1.12;
      overflow-wrap: anywhere;
    }
  }
</style>
