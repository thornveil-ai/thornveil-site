---
import BaseLayout from '../layouts/BaseLayout.astro';
import metrics from '../data/metrics.json';
const m = metrics;

const features = [
  {
    title: 'Survives worker loss.',
    body: 'Substitute-on-failure dispatch at the per-token MoE expert dimension. When half the mesh becomes unreachable mid-token, the coordinator substitutes a zero vector for the missing expert and the dense MLP keeps producing. Output coherence degrades proportionally to loss, not catastrophically.',
    tag: 'RTP 2026-05-08',
  },
  {
    title: 'OpenAI-compatible chat endpoint.',
    body: 'Any client that speaks /v1/chat/completions works without code changes. The mesh is an implementation detail your operators never see — they get the same interface their tooling already targets.',
    tag: 'MOSA',
  },
  {
    title: 'Tamper-evident audit chain.',
    body: 'Each chat is recorded in a canonical-JSON ledger with an HMAC chain and RFC 3161 trusted timestamps. A replay package is available under an evaluation NDA for end-to-end chain verification by a 3PAO.',
    tag: 'Sealed',
  },
];

const tiers = [
  { tier: 'Micro',    hardware: 'Raspberry Pi · mobile',         capacity: '0.6B – 3B',  role: 'Edge routing, simple queries' },
  { tier: 'Edge',     hardware: 'Laptop (8GB) · Jetson',         capacity: '3B – 8B',    role: 'Token gen, classification' },
  { tier: 'Standard', hardware: 'Desktop GPU (RTX 3060+)',       capacity: '8B – 14B',   role: 'General inference' },
  { tier: 'Power',    hardware: 'Workstation (24GB+ VRAM)',      capacity: '14B – 70B',  role: 'Complex reasoning · expert hosting' },
  { tier: 'Fortress', hardware: 'Multi-GPU server',              capacity: '70B+',       role: 'Heavy inference · training · aggregation' },
];

const honestStatus = [
  { label: 'v1.0.0 tagged',                              state: 'live', detail: 'Cosign-signed binaries on GitHub. SBOMs. Reproducible build.' },
  { label: 'Operator UI + ops dashboard',                state: 'live', detail: 'Web interfaces for operators and evaluators. The Docker evaluator stack is described in the quickstart.' },
  { label: 'Substitute-on-failure dispatch',             state: 'live', detail: 'Reduction-to-practice recorded 2026-05-08 with HMAC-chained evidence. Replayable.' },
  { label: 'NIST 800-53 controls mapping',               state: 'live', detail: 'Author\'s interpretation. 41 of 44 in-scope controls met (2 partial, 1 N/A). Pending 3PAO review.' },
  { label: 'Physical ruggedized-tablet validation',      state: 'warn', detail: 'Demonstrated on RTX PRO 6000 with 6 simulated worker processes; physical bench scheduled when partner hardware lands.' },
  { label: 'NIST FIPS 140-3 certification',              state: 'warn', detail: 'FIPS-cipher-list build option exists; module validation not yet pursued.' },
];

const r2iBullets = [
  'Exposed APIs — OpenAI-compatible /v1/chat/completions, /healthz, /mesh/status, /audit/verify, /v1/models',
  'Published documentation — OpenAPI 3.1.0, operator runbook, threat model, NIST 800-53 mapping, STIG-lite',
  'Vendor-neutral — any OpenAI-compatible client connects without code changes',
  'Modular Open Systems Architecture — coordinator + workers cleanly separated; pluggable fallback model',
  'Cryptographically auditable — every chat HMAC-chained into a tamper-evident ledger',
  'No vendor lock-in — cosign-signed binaries (Linux + Windows + macOS, RPM + DEB + .exe + .dmg)',
];

const heroPills = [
  { label: 'R2I-aligned',         tone: 'live' },
  { label: `${m.systems.mycelium.version} · cosign-signed`, tone: 'ghost' },
  { label: 'Day-27 RTP validated', tone: 'ghost' },
];
---

<BaseLayout
  title="Mycelium | Distributed AI Mesh | Thornveil"
  description="Mycelium is a distributed mixture-of-experts inference engine. Six workers pooling compute for one Gemma-4-26B chat. When half the mesh dies, substitute-on-failure dispatch keeps producing tokens. v1.0.0 cosign-signed."
>
  <!-- HERO -->
  <section class="tv-section pt-s-11">
    <div class="tv-container">
      <div class="flex items-center gap-s-2 mb-s-4 flex-wrap reveal">
        {heroPills.map((p) => (
          <span class={`tv-pill ${p.tone === 'live' ? 'tv-pill--live' : 'tv-pill--ghost'}`}>{p.label}</span>
        ))}
      </div>

      <h1 class="tv-h1 mt-s-3 reveal reveal-delay-1" style="max-width: 18ch;">
        AI that keeps thinking<br/>when half the team goes dark.
      </h1>
      <p class="text-step-1 text-text-2 mt-s-5 reveal reveal-delay-2" style="max-width: 64ch;">
        Picture six computers working together on one conversation — like teammates sharing the load.
        Now picture three of them getting unplugged, jammed, or destroyed mid-sentence.
        <strong class="text-text"> With Mycelium, the conversation just keeps going.</strong>
        No pause. No restart. No "something went wrong." That's the breakthrough — and you can watch it
        happen in three seconds, just below.
      </p>

      <div class="mt-s-7 flex flex-wrap gap-s-3 reveal reveal-delay-3">
        <a href="#mesh-in-action" class="tv-btn tv-btn--primary">Show me →</a>
        <a href="https://github.com/thornveil-ai/mycelium-overview#mycelium-evaluator-quickstart"
           target="_blank" rel="noopener"
           class="tv-btn tv-btn--secondary">Try it on your laptop →</a>
        <a href="mailto:jesse@thornveil.ai?subject=Mycelium%20live%20demo"
           class="tv-btn tv-btn--secondary">Request a demo by email →</a>
      </div>
      <p class="text-step--1 text-text-2 mt-s-3">
        Demo requests open your email app with a subject filled in. Send the email to discuss a time;
        selecting the link does not book a demo.
      </p>

      <!-- HERO PRODUCT SHOT -->
      <figure class="mt-s-10 reveal reveal-delay-3" style="margin-inline: 0;">
        <div style="position: relative; border: 1px solid var(--line-strong); background: var(--bg-raised); overflow: hidden;">
          <div class="flex items-center gap-s-3 px-s-4 py-s-3 border-b border-line">
            <span style="width:10px;height:10px;border-radius:50%;background:var(--text-3);"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:var(--text-3);"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:var(--text-3);"></span>
            <span class="font-mono text-step--1 tracking-[0.05em] text-text-3 ml-s-3">localhost:8094/dashboard</span>
            <span class="font-mono text-step--1 tracking-[0.18em] uppercase text-signal-text ml-auto">LIVE</span>
          </div>
          <img src="/mycelium/dashboard-baseline.png" alt="Mycelium ops dashboard — six worker tiles pooling compute for one Gemma-4-26B chat" style="display:block; width:100%; height:auto;" />
        </div>
        <figcaption class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-4 text-center">
          Six workers generating one response ·
          {' '}<a href="#mesh-in-action" class="text-signal-text">see the three-worker-loss comparison →</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <nav class="tv-section pt-0 mycelium-local-nav" aria-label="On this page">
    <div class="tv-container">
      <div class="mycelium-local-nav__inner">
        <span class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">On this page</span>
        <div class="mycelium-local-nav__links">
          <a href="#mechanism">Mechanism</a>
          <a href="#mesh-in-action">Mesh in action</a>
          <a href="#right-to-integrate">R2I</a>
          <a href="#hardware-tiers">Hardware</a>
          <a href="#installation">Install</a>
          <a href="#implementation-status">Status</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- THREE PILLARS -->
  <section class="tv-section pt-0" style="background: var(--bg-raised); border-top: 1px solid var(--line);">
    <div class="tv-container">
      <div class="mb-s-7 max-w-3xl">
        <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Three things you can verify.</h2>
        <p class="text-step-0 text-text-2 mt-s-4 reveal reveal-delay-2" style="max-width: 60ch;">
          Review the mechanisms in the
          {' '}<a href="https://github.com/thornveil-ai/mycelium-overview" target="_blank" rel="noopener" class="text-signal-text underline underline-offset-4 decoration-1">public companion repository</a>
          {' '}or request a 30-minute walkthrough.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-s-5">
        {features.map((f, i) => (
          <div class={`tv-tile reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <span class="tv-pill tv-pill--ghost mb-s-4">{f.tag}</span>
            <h3 class="text-step-1 text-text mt-s-4 mb-s-3" style="font-variation-settings: 'wdth' 125;">{f.title}</h3>
            <p class="text-step-0 text-text-2">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE MECHANISM -->
  <section id="mechanism" class="tv-section pt-0" aria-labelledby="mechanism-heading" tabindex="-1">
    <div class="tv-container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-s-9 items-start">
        <div class="lg:col-span-2">
          <h2 id="mechanism-heading" class="tv-h2 mt-s-3 mb-s-5 reveal reveal-delay-1">How zero-vector substitution works</h2>
          <p class="text-step-0 text-text-2 mb-s-4 reveal reveal-delay-2">
            Distributed inference frameworks don't document what happens when an inference worker becomes
            unreachable mid-token. Most options are catastrophic: hang, error, drop the request. Mycelium's
            coordinator substitutes a zero vector for the unreachable worker's experts and the dense MLP path
            keeps producing tokens. Output coherence degrades proportionally to loss.
          </p>
          <p class="font-mono text-step--1 tracking-[0.08em] uppercase text-text-3 reveal reveal-delay-3">
            Day-27 reduction-to-practice recorded 2026-05-08 with HMAC-chained tamper-evident evidence.
            Not in any chaos-engineering catalog. Not in MITRE's experiment-process methodology. Not in NIST SP 800-204.
          </p>
        </div>

        <div class="lg:col-span-3">
          <div class="tv-tile">
            <h3 class="text-step-1 text-text mb-s-3" style="font-variation-settings: 'wdth' 125;">Distributed adaptive AI mesh network</h3>
            <p class="font-mono text-step--1 tracking-[0.05em] uppercase text-text-3 mb-s-5">
              Predictive expert prefetching · cross-model style normalization · behavioral proof-of-inference verification
            </p>
            <ul class="space-y-s-3 text-step-0 text-text-2">
              <li class="flex gap-s-3"><span class="text-signal-text shrink-0">›</span> Substitute-on-failure dispatch on the per-token MoE expert dimension</li>
              <li class="flex gap-s-3"><span class="text-signal-text shrink-0">›</span> HMAC-chained tamper-evident audit ledger over canonical-JSON</li>
              <li class="flex gap-s-3"><span class="text-signal-text shrink-0">›</span> Behavioral fingerprinting + Merkle execution traces + economic reputation</li>
              <li class="flex gap-s-3"><span class="text-signal-text shrink-0">›</span> Auditable replay package available under evaluation NDA</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MESH IN ACTION (before/after) -->
  <section id="mesh-in-action" class="tv-section pt-0" aria-labelledby="mesh-heading" tabindex="-1" style="background: var(--bg-inset); border-top: 1px solid var(--line);">
    <div class="tv-container">
      <div class="text-center mb-s-7">
        <h2 id="mesh-heading" class="tv-h2 mt-s-3 reveal reveal-delay-1">Same screen. Three seconds apart.</h2>
        <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 64ch;">
          On the <strong class="text-text">left</strong>: six computers, all green, working together on one
          answer. On the <strong class="text-text">right</strong>: three are dead — and the answer is
          <em>still coming through</em>. Nobody hit a button. Nothing was rerouted. The system simply kept
          going. <strong class="text-text">Substitute-on-failure dispatch at the MoE expert dimension —
          not in any chaos-engineering catalog, not in MITRE, not in NIST SP 800-204.</strong>
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-s-6 reveal reveal-delay-2">
        <!-- Before -->
        <figure style="margin:0;">
          <div style="border: 1px solid var(--line); overflow: hidden;">
            <div class="flex items-center gap-s-3 px-s-4 py-s-3 border-b border-line">
              <span style="width:8px;height:8px;border-radius:50%;background:var(--signal);"></span>
              <span style="width:8px;height:8px;border-radius:50%;background:var(--signal);"></span>
              <span style="width:8px;height:8px;border-radius:50%;background:var(--signal);"></span>
              <span class="font-mono text-step--1 tracking-[0.05em] text-text-3 ml-s-3">t = 0s · alive 6/6</span>
            </div>
            <img src="/mycelium/dashboard-baseline.png" alt="Baseline: six workers green" style="display:block; width:100%; height:auto;" />
          </div>
          <figcaption class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-3 text-center">
            <span class="text-signal-text">BEFORE</span> · All six computers working together.
          </figcaption>
        </figure>

        <!-- After -->
        <figure style="margin:0;">
          <div style="border: 1px solid var(--warn); overflow: hidden;">
            <div class="flex items-center gap-s-3 px-s-4 py-s-3 border-b border-line">
              <span style="width:8px;height:8px;border-radius:50%;background:var(--warn);"></span>
              <span style="width:8px;height:8px;border-radius:50%;background:var(--warn);"></span>
              <span style="width:8px;height:8px;border-radius:50%;background:var(--warn);"></span>
              <span class="font-mono text-step--1 tracking-[0.05em] text-text-3 ml-s-3">t = 3s · alive 3/6</span>
            </div>
            <img src="/mycelium/dashboard-half-down.png" alt="Three workers dead, substituted with zero vector — the team is still thinking" style="display:block; width:100%; height:auto;" />
          </div>
          <figcaption class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-3 text-center">
            <span style="color: var(--warn);">AFTER</span> · Three are dead. The answer is still coming through.
          </figcaption>
        </figure>
      </div>

      <div class="mt-s-7 text-center max-w-2xl mx-auto reveal reveal-delay-3">
        <p class="text-step-0 text-text-2">The user typing the question never noticed anything happened.</p>
        <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-4">
          Filmed live · 2026-05-08 · HMAC-chained audit log · Replay package available under evaluation NDA
        </p>
      </div>
    </div>
  </section>

  <!-- R2I -->
  <section id="right-to-integrate" class="tv-section pt-0" aria-labelledby="r2i-heading" tabindex="-1">
    <div class="tv-container max-w-3xl">
      <div class="text-center mb-s-7">
        <span class="tv-pill tv-pill--live">RIGHT TO INTEGRATE</span>
        <h2 id="r2i-heading" class="tv-h2 mt-s-4 reveal">R2I-compliant by design.</h2>
        <p class="text-step-0 text-text-2 mt-s-4 italic reveal reveal-delay-1" style="max-width: 52ch; margin-inline: auto;">
          "If you do not expose your interfaces and your documentation, you will not be able to join the ecosystem."
        </p>
        <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mt-s-2 reveal reveal-delay-1">
          — Secretary of the Army Dan Driscoll · R2I hackathon announcement, 2026-05-05
        </p>
      </div>

      <div class="tv-tile reveal reveal-delay-2">
        <ul class="space-y-s-4 text-step-0 text-text-2">
          {r2iBullets.map((b) => (
            <li class="flex gap-s-3"><span class="text-signal-text shrink-0" aria-hidden="true">✓</span><span>{b}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- HARDWARE TIERS -->
  <section id="hardware-tiers" class="tv-section pt-0" aria-labelledby="hardware-heading" tabindex="-1">
    <div class="tv-container">
      <div class="text-center mb-s-7">
        <h2 id="hardware-heading" class="tv-h2 mt-s-3 reveal reveal-delay-1">Hardware detection assigns a tier.</h2>
        <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 64ch;">
          Mycelium detects local hardware on first run and assigns a tier. The mesh aggregates tier
          capability live; available models grow as peers join.
        </p>
      </div>

      <div class="mycelium-table-scroll border border-line reveal reveal-delay-2" tabindex="0" role="region" aria-label="Hardware tier reference" aria-describedby="hardware-scroll-note">
        <table class="w-full text-step-0">
          <caption>Mycelium hardware detection tiers</caption>
          <thead style="background: var(--bg-raised);">
            <tr>
              <th scope="col" class="text-left p-s-4 font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">Tier</th>
              <th scope="col" class="text-left p-s-4 font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">Hardware</th>
              <th scope="col" class="text-left p-s-4 font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">Capacity</th>
              <th scope="col" class="text-left p-s-4 font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">Role</th>
            </tr>
          </thead>
          <tbody>
            {tiers.map((t) => (
              <tr style="border-top: 1px solid var(--line);">
                <th scope="row" class="p-s-4 text-left font-mono tabular text-signal-text">{t.tier}</th>
                <td class="p-s-4 text-text-2">{t.hardware}</td>
                <td class="p-s-4 font-mono tabular text-text-3">{t.capacity}</td>
                <td class="p-s-4 text-text-2">{t.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="hardware-scroll-note" class="font-mono text-step--1 tracking-[0.05em] text-text-3 mt-s-3">Scroll horizontally to view all columns. Focus the table and use arrow keys, a trackpad, mouse wheel, or touch to move sideways.</p>
    </div>
  </section>

  <!-- 5-MIN INSTALL -->
  <section id="installation" class="tv-section pt-0" aria-labelledby="installation-heading" tabindex="-1" style="background: var(--bg-raised); border-top: 1px solid var(--line);">
    <div class="tv-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-s-9 items-start">
        <div>
          <h2 id="installation-heading" class="tv-h2 mt-s-3 mb-s-5 reveal reveal-delay-1">Operator UX on any laptop. No GPU.</h2>
          <p class="text-step-0 text-text-2 mb-s-4 reveal reveal-delay-2">
            The evaluator stack provides operator chat and dashboard interfaces with simulated worker state;
            disable workers in the dashboard to see its display update. The image is approximately 50 MB and
            requires neither a GPU nor a model checkpoint.
          </p>
          <p class="font-mono text-step--1 tracking-[0.08em] uppercase text-text-3 reveal reveal-delay-3">
            For the production stack — six GPU workers running real Gemma-4-26B-A4B FP8 with substitute-on-failure
            dispatch — see <a href="https://github.com/thornveil-ai/mycelium-overview#install" target="_blank" rel="noopener" class="text-signal-text">docs/INSTALL.md</a>.
          </p>
        </div>

        <pre class="mycelium-install-code font-mono text-step--1 leading-relaxed reveal reveal-delay-2 p-s-5" tabindex="0" aria-label="Evaluator installation commands. Scroll horizontally to view long lines." style="background: var(--bg-inset); color: var(--text); border: 1px solid var(--line); overflow-x: auto;"><code><span class="text-text-3">$ git clone https://github.com/thornveil-ai/mycelium-overview.git
$ cd mycelium
</span><span class="text-signal-text">$ docker compose -f docker-compose.evaluator.yaml up</span>
<span class="text-text-3">
# Then open</span>
→ http://localhost:8094/          <span class="text-text-3"># operator chat</span>
→ http://localhost:8094/dashboard <span class="text-text-3"># ops dashboard</span></code></pre>
      </div>
    </div>
  </section>

  <!-- HONEST STATUS -->
  <section id="implementation-status" class="tv-section pt-0" aria-labelledby="status-heading" tabindex="-1">
    <div class="tv-container">
      <div class="text-center mb-s-7">
        <h2 id="status-heading" class="tv-h2 mt-s-3 reveal reveal-delay-1">Implementation status and pending validation</h2>
        <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
          The status below separates released components from work awaiting validation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-4">
        {honestStatus.map((s, i) => (
          <div class={`tv-tile reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <div class="flex items-start justify-between gap-s-3 mb-s-3 flex-wrap">
              <h3 class="text-step-1 text-text" style="font-variation-settings: 'wdth' 125;">{s.label}</h3>
              <span class={`tv-pill ${s.state === 'live' ? 'tv-pill--live' : 'tv-pill--warn'} shrink-0`}>
                {s.state === 'live' ? 'today' : 'roadmap'}
              </span>
            </div>
            <p class="text-step-0 text-text-2">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="tv-section pt-0" style="background: var(--bg-inset); border-top: 1px solid var(--line);">
    <div class="tv-container max-w-2xl text-center">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Build the AI tier of your stack on Mycelium.</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
        Contact Jesse to discuss standards participation, licensing or a live demonstration. Direct contracts
        open {m.company.directContractsOpen}.
      </p>
      <div class="mt-s-7 flex flex-wrap gap-s-3 justify-center reveal reveal-delay-3">
        <a href="mailto:jesse@thornveil.ai?subject=Mycelium" class="tv-btn tv-btn--primary">Email jesse@thornveil.ai</a>
        <a href="/contact" class="tv-btn tv-btn--secondary">Contact details →</a>
      </div>
      <p class="text-step--1 text-text-2 mt-s-3">
        The email link opens your email app. If no app opens, copy the address into your usual email service.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  figcaption a { display: inline-flex; align-items: center; min-height: 44px; }
  h1, h2, h3, p, li, .tv-btn, .tv-pill { overflow-wrap: anywhere; }
  .tv-pill { white-space: normal; max-width: 100%; }
  .grid > *, .tv-tile { min-width: 0; }
  .mycelium-local-nav {
    padding-bottom: var(--s-5);
  }

  .mycelium-local-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .mycelium-local-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
  }

  .mycelium-local-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.35em;
  }

  .mycelium-local-nav a:hover,
  .mycelium-local-nav a:focus-visible {
    color: var(--signal-text);
    text-decoration-color: currentColor;
  }

  .mycelium-table-scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .mycelium-table-scroll:focus-visible,
  .mycelium-install-code:focus-visible {
