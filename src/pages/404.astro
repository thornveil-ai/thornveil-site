---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Thornveil">
  <section class="tv-section pt-s-11 min-h-[70vh] flex items-center">
    <div class="tv-container text-center">
      <h1 class="tv-h1 mx-auto reveal" style="max-width: none;">Page not found.</h1>
      <p class="text-step-1 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
        The path you requested is not declared in the Thornveil scope.
      </p>
      <div class="mt-s-7 reveal reveal-delay-3 flex flex-wrap gap-s-3 justify-center">
        <a href="/" class="tv-btn tv-btn--primary">
          Return to home
          <span aria-hidden="true">→</span>
        </a>
        <a href="/systems" class="tv-btn tv-btn--secondary">
          Browse the 10 systems
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
