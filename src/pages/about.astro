---
import BaseLayout from '../layouts/BaseLayout.astro';
import metrics from '../data/metrics.json';

const m = metrics;

const credentials = [
  { label: 'Status',     value: 'Active-duty USMC · DD-214 December 10, 2026' },
  { label: 'Clearance',  value: 'TS/SCI' },
  { label: 'Service',    value: 'USMC, Staff Sergeant (8+ years)' },
  { label: 'Discipline', value: 'Signals Intelligence — 6 countries deployed' },
  { label: 'Languages',  value: 'Modern Standard Arabic + 3 dialects' },
  { label: 'Education',  value: 'BA, Arabic — Defense Language Institute' },
];
---

<BaseLayout
  title="About | Thornveil"
  description="Thornveil is a one-person research and engineering shop founded by Jesse Morgan — an active-duty USMC Signals Intelligence Marine building sovereign AI infrastructure."
>
  <!-- HERO -->
  <section class="tv-section pt-s-11">
    <div class="tv-container max-w-3xl">
      <h1 class="tv-h1 mt-s-3 reveal reveal-delay-1">
        The shift from analyst to builder happened gradually, then all at once.
      </h1>
      <p class="text-step-1 text-text-2 mt-s-6 reveal reveal-delay-2" style="max-width: 64ch;">
        I'm Jesse Morgan. I founded Thornveil to build the AI infrastructure I wanted to use as an analyst —
        local, data-sovereign, accountable to the people running it. Eight years as a Signals Intelligence
        Marine — six countries, national-level reporting under classified handling — taught me how brittle
        the cloud-dependent toolchain is for the people doing the actual mission.
      </p>
    </div>
  </section>

  <!-- BACKGROUND PROSE — net-new context only -->
  <section class="tv-section pt-0">
    <div class="tv-container max-w-3xl">
      <div class="space-y-s-5 text-step-0 text-text-2 reveal">
        <p>
          I taught myself to code on overnight watches, then on weekends, then between deployments.
          Each system in the
          {' '}<a href="/systems" class="text-signal-text underline underline-offset-4 decoration-1">portfolio</a>
          {' '}solves a problem I ran into firsthand: brittle cloud routing for classified queries,
          inference that hangs the second a worker drops, audit chains that won't survive a 3PAO,
          autopilots that can't tell the difference between a real GPS signal and a spoofed one.
        </p>
        <p>
          Active-duty until {m.company.directContractsOpen}. That's a regulatory constraint, not an
          execution constraint — the work keeps shipping. What it means for federal evaluators: we can
          start the technical conversation today, walk you through the substrate today, sign an evaluation
          NDA today. Direct contracts queue for December.
        </p>
        <p>
          Co-founder applications are
          {' '}<a href="/cofounder" class="text-signal-text underline underline-offset-4 decoration-1">open</a>
          {' '}for a senior offensive cyber operator with a post-uniform defense-AI startup rotation.
        </p>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="tv-section">
    <div class="tv-container max-w-3xl">
      <h2 class="tv-h2 mt-s-3 mb-s-6 reveal reveal-delay-1">Background</h2>
      <div class="tv-tile reveal reveal-delay-2">
        <dl class="space-y-s-4">
          {credentials.map((c) => (
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-s-2 pb-s-3 border-b border-line last:border-0 last:pb-0">
              <dt class="font-mono text-step--1 tracking-[0.12em] uppercase text-text-3">{c.label}</dt>
              <dd class="text-step-0 text-text">{c.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="tv-section pt-0">
    <div class="tv-container max-w-2xl text-center">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Want to talk?</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
        Direct line to the founder. Federal inquiries welcome — direct contracts open {m.company.directContractsOpen}.
        Co-founder applications open now. Tell me what you're working on; the substrate is already there
        to compound onto.
      </p>
      <div class="mt-s-7 reveal reveal-delay-3">
        <a href="mailto:jesse@thornveil.ai" class="tv-btn tv-btn--primary">jesse@thornveil.ai</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
  function isAnimatable(s) { return /^\d+(\.\d+)?[KMB]?$/.test(s); }
  document.querySelectorAll('[data-countup]').forEach((el) => {
    const target = el.dataset.countup ?? '';
    if (!isAnimatable(target)) return;
    const suffix = (target.match(/[KMB]$/) ?? [''])[0];
    const final  = parseFloat(target.replace(/[KMB]$/, ''));
    if (Number.isNaN(final)) return;
    const start = performance.now();
    const tick  = (t) => {
      const e = Math.min(1, (t - start) / 720);
      const v = final * easeOutCubic(e);
      const shown = Number.isInteger(final) ? Math.round(v) : v.toFixed(1);
      el.textContent = `${shown}${suffix}`;
      if (e < 1) requestAnimationFrame(tick);
      else el.textContent = target;
    };
    requestAnimationFrame(tick);
  });
</script>
