---
import BaseLayout from '../layouts/BaseLayout.astro';
import MyceliumHero from '../components/MyceliumHero.jsx';
import MeshFallback from '../components/MeshFallback.astro';
import SystemsConstellation from '../components/SystemsConstellation.astro';
import AudienceIntake from '../components/AudienceIntake.astro';
import FounderCard from '../components/FounderCard.astro';
import ShippingLog from '../components/ShippingLog.astro';
import metrics from '../data/metrics.json';

const m = metrics;
const heroStats = m.myceliumHero;
const pageStats = m.homepageMetrics;

const pillars = [
  m.systems.rigrun,
  m.systems.pyros,
  m.systems.mycelium,
  m.systems.auspex,
];
const others = [
  m.systems.signet,
  m.systems.alchemist,
  m.systems.hawkstack,
  m.systems.meridian,
  m.systems.canopy,
  m.systems.navigator,
];

// Reduction-to-practice — a fixed historical date, not a moving counter.
// Day-27 of the engagement is when RTP was recorded.
const myceliumRtpDate = m.systems.mycelium.rtpDate;
---

<BaseLayout
  title="Thornveil | Sovereign AI infrastructure"
  description="Ten engineering systems for sovereign federal AI infrastructure. IL5-ready, ECCN-aware, governance-first. Built solo while active-duty USMC. Direct contracts open December 10, 2026."
>
  <!-- ============================== HERO ============================== -->
  <section
    class="relative w-full overflow-hidden"
    style="background: var(--bg-inset); min-height: 100vh;"
  >
    <!-- WebGL mesh (R3F island, hydrates on idle since hero is above-the-fold). -->
    <MyceliumHero client:idle />

    <!-- Static SVG fallback for no-JS contexts. The island layer paints over it. -->
    <noscript>
      <MeshFallback />
    </noscript>

    <!-- Text-legibility mask. Darkens the left third where text sits, fades
         to transparent on the right where the mesh shines. Keeps the wow
         visible AND keeps the lead paragraph readable. -->
    <div
      aria-hidden="true"
      style="position: absolute; inset: 0; pointer-events: none;
             background: linear-gradient(to right,
               rgba(5,11,24,0.78) 0%,
               rgba(5,11,24,0.55) 22%,
               rgba(5,11,24,0.15) 48%,
               rgba(5,11,24,0) 70%);"
    ></div>

    <!-- Foreground content. Fixed at 100vh; the WebGL mesh sits behind,
         the H1 + lead + CTAs are the only foreground elements. -->
    <div class="relative tv-container pt-s-11 pb-s-9 flex flex-col justify-center" style="height: 100vh; min-height: 640px;">
      <h1 class="tv-h1 line-reveal" style="max-width: 18ch;">
        <span>Sovereign AI</span>
        <span>you can run in a SCIF.</span>
      </h1>

      <p class="tv-lead mt-s-5 reveal reveal-delay-2">
        Ten federally-fit systems shipped solo while active-duty USMC.
        The mesh on this page is one of them — Mycelium, surviving when half its workers die.
      </p>

      <!-- CTA row — primary anchors down to audience intake (highest-leverage conversion path) -->
      <div class="mt-s-7 flex flex-wrap gap-s-3 reveal reveal-delay-3">
        <a href="#pick-your-track" class="tv-btn tv-btn--primary plausible-event-name=Hero+Pick+Track">
          Pick your track
          <span aria-hidden="true">↓</span>
        </a>
        <a href="/mycelium" class="tv-btn tv-btn--secondary plausible-event-name=Hero+Mycelium+Deep+Dive">
          Mycelium deep dive ↗
        </a>
      </div>
    </div>

    <!-- bottom hairline — marks the seam between hero and platform section -->
    <div class="absolute bottom-0 left-0 right-0 border-t border-line" aria-hidden="true"></div>
  </section>

  <!-- ============================== AUDIENCE INTAKE (highest conversion lever) ============================== -->
  <div id="pick-your-track"></div>
  <AudienceIntake />

  <!-- ============================== PLATFORM (4 pillars) ============================== -->
  <section class="tv-section" style="background: var(--bg);">
    <div class="tv-container">
      <div class="mb-s-8">
        <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Four flagship systems. Six more on the org.</h2>
        <div class="tv-rule" role="separator"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-5">
        {pillars.map((p, i) => (
          <a
            href={p.name === 'Mycelium' ? '/mycelium' : `/systems#${p.name.toLowerCase()}`}
            class={`tv-tile reveal reveal-delay-${Math.min(i + 1, 4)}`}
          >
            <!-- top row: status pill + LOC mono -->
            <div class="flex items-start justify-between gap-s-3 mb-s-5">
              <span class={`tv-pill ${p.status === 'live' ? 'tv-pill--live' : 'tv-pill--warn'}`}>
                {p.statusLabel}
              </span>
              {p.loc ? (
                <span class="font-mono tabular text-text-3 text-step--1 uppercase tracking-[0.10em]">
                  {p.loc} LOC
                </span>
              ) : null}
            </div>

            <h3 class="text-step-2 mb-s-3" style="font-variation-settings: 'wdth' 125;">{p.name}</h3>
            <p class="text-step-0 text-text-2 max-w-prose mb-s-5">{p.summary}</p>

            <div class="border-t border-line pt-s-4 flex flex-wrap items-center gap-x-s-4 gap-y-s-1 font-mono tabular text-step--1 text-text-3 uppercase tracking-[0.10em]">
              <span>{p.version || p.statusLabel}</span>
              {p.repo ? (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{p.repo.replace('github.com/thornveil-ai/','')}</span>
                </>
              ) : null}
              <span aria-hidden="true" class="ml-auto text-signal-text">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== FOUNDER CARD ============================== -->
  <FounderCard />

  <!-- ============================== 10-SYSTEMS CONSTELLATION ============================== -->
  <section class="tv-section pt-0" style="background: var(--bg);">
    <div class="tv-container">
      <div class="mb-s-7">
        <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Ten systems. One integrated graph.</h2>
        <p class="tv-lead mt-s-4 reveal reveal-delay-2" style="max-width: 64ch;">
          Each system is shipped on its own, but they're designed to compose.
          Hover any node to see what it depends on, and what depends on it.
        </p>
      </div>
      <div class="reveal reveal-delay-3">
        <SystemsConstellation />
      </div>

      <div class="mt-s-7 flex justify-center reveal reveal-delay-4">
        <a href="/systems" class="tv-btn tv-btn--secondary">
          Open all 10 system specs →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================== SHIPPING LOG ============================== -->
  <ShippingLog />

  <!-- ============================== POSTURE ============================== -->
  <section class="tv-section" style="background: var(--bg-raised); border-top: 1px solid var(--line);">
    <div class="tv-container max-w-3xl">
      <h2 class="tv-h2 mt-s-3 mb-s-5 reveal reveal-delay-1">A patient build, in the open.</h2>
      <div class="space-y-s-4 text-step-0 text-text-2 reveal reveal-delay-2">
        <p>
          Thornveil is {m.portfolio.totalSystems} engineering systems for sovereign federal AI
          infrastructure — safety gate, AI red team, IL5-pathway chat, sub-million-parameter perception,
          distributed mesh, autopilot firmware, and the internal agent factory that ships them.
          Built ground-up to clear FedRAMP, IL5, and ECCN review on day one — not retrofitted.
        </p>
        <p>
          The founder is active-duty USMC. Direct federal contracts open
          {' '}{m.company.directContractsOpen}. Co-founder applications open now:
          {' '}<a href="/cofounder" class="text-signal-text underline underline-offset-4 decoration-1">
            senior offensive cyber operator
          </a>
          {' '}with post-uniform defense-AI startup rotation.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================== CTA ============================== -->
  <section class="tv-section" style="background: var(--bg);">
    <div class="tv-container max-w-2xl text-center">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Want to review, or co-found?</h2>
      <p class="text-step-0 text-text-2 mt-s-4 reveal reveal-delay-2" style="margin-inline: auto; max-width: 52ch;">
        Inquiries welcome. Co-founder applications welcome. Direct contracts open post-separation
        ({m.company.directContractsOpen}).
      </p>
      <div class="mt-s-7 flex gap-s-3 justify-center flex-wrap reveal reveal-delay-3">
        <a href="mailto:jesse@thornveil.ai" class="tv-btn tv-btn--primary">
          jesse@thornveil.ai
        </a>
        <a href="/cofounder" class="tv-btn tv-btn--secondary">
          Co-founder profile →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import Lenis from 'lenis';

  // Skip Lenis for reduced-motion users
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    const lenis = new Lenis({
      duration: 1.0,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });
    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.querySelector((anchor as HTMLAnchorElement).getAttribute('href')!);
        if (target) lenis.scrollTo(target as HTMLElement);
      });
    });
  }

  // Count-up — runs once, on load, for mono stat numbers
  function easeOutCubic(t: number) { return 1 - Math.pow(1 - t, 3); }
  function isAnimatable(s: string) {
    return /^\d+(\.\d+)?[KMB]?$/.test(s);
  }
  document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
    const target = el.dataset.countup ?? '';
    if (!isAnimatable(target)) return;
    const suffix = (target.match(/[KMB]$/) ?? [''])[0];
    const final  = parseFloat(target.replace(/[KMB]$/, ''));
    if (Number.isNaN(final)) return;
    const start = performance.now();
    const dur   = 720;
    const tick  = (t: number) => {
      const e = Math.min(1, (t - start) / dur);
      const v = final * easeOutCubic(e);
      const shown = (Number.isInteger(final) ? Math.round(v) : v.toFixed(1));
      el.textContent = `${shown}${suffix}`;
      if (e < 1) requestAnimationFrame(tick);
      else el.textContent = target;
    };
    requestAnimationFrame(tick);
  });
</script>
