---
import BaseLayout from '../layouts/BaseLayout.astro';
import metrics from '../data/metrics.json';
// Per-system visualizations — one bespoke graphic per tile.
import SignetViz    from '../components/system-viz/signet-viz.astro';
import AlchemistViz from '../components/system-viz/alchemist-viz.astro';
import PyrosViz     from '../components/system-viz/pyros-viz.astro';
import MyceliumViz  from '../components/system-viz/mycelium-viz.astro';
import RigRunViz    from '../components/system-viz/rigrun-viz.astro';
import HawkStackViz from '../components/system-viz/hawkstack-viz.astro';
import MeridianViz  from '../components/system-viz/meridian-viz.astro';
import CanopyViz    from '../components/system-viz/canopy-viz.astro';
import AuspexViz    from '../components/system-viz/auspex-viz.astro';
import NavigatorViz from '../components/system-viz/navigator-viz.astro';

const vizFor = {
  Signet:    SignetViz,
  Alchemist: AlchemistViz,
  Pyros:     PyrosViz,
  Mycelium:  MyceliumViz,
  RigRun:    RigRunViz,
  HawkStack: HawkStackViz,
  Meridian:  MeridianViz,
  Canopy:    CanopyViz,
  Auspex:    AuspexViz,
  Navigator: NavigatorViz,
};
const m = metrics;

// All 10 systems with audit-verified metrics.
const systems = [
  {
    name: 'Signet',
    tagline: 'Capability gates for LLM agents.',
    description: '4-stage check pipeline (ADMISSION / INSPECTION / COMMITMENT / RECORD) with HMAC-chained tamper-evident audit log and RFC 3161 trusted-timestamp anchoring. 11 production checks. Auspex extends Signet\'s check vocabulary with checks specific to each engagement. Apache-2.0 OSS. Available on PyPI as `signet-sign`.',
    stat: '25K + 31K', statLabel: 'source LOC + test LOC',
    status: 'live', statusLabel: 'v0.1.10.1 · public OSS',
    repoUrl: 'https://github.com/thornveil-ai/signet',
    repoLabel: 'thornveil-ai/signet',
    detail: null,
  },
  {
    name: 'Alchemist',
    tagline: 'Algorithm-aware C-to-Rust translation.',
    description: 'Five correctness gates: compile, anti-stub, no-unsafe, cargo test, differential (10K/10K against C reference). The pipeline refuses to claim success without a differential config. Local LLM only — no cloud paths. Built for the CISA / DoD / ONCD memory-safe regulatory tide.',
    stat: '21K', statLabel: 'Python LOC + 546 tests',
    status: 'warn', statusLabel: 'research prototype · public OSS',
    repoUrl: 'https://github.com/thornveil-ai/alchemist',
    repoLabel: 'thornveil-ai/alchemist',
    detail: null,
  },
  {
    name: 'Pyros',
    tagline: 'Adaptive controls for inference backends.',
    description: 'One orchestrator coordinates 24 adaptive subsystems in seven groups. It combines PID control with Holt forecasting, a UCB1 bandit and epsilon-greedy variant evolution. PAVA isotonic regression calibrator validated against sklearn. Race-clean across Linux/macOS/Windows. Backend-agnostic — wraps Ollama, vLLM, llama.cpp, LMStudio.',
    stat: '17K', statLabel: 'Go LOC · race-clean',
    status: 'live', statusLabel: 'v0.2.1 · used in RigRun + Mycelium',
    repoUrl: 'https://github.com/thornveil-ai/pyros-overview',
    repoLabel: 'thornveil-ai/pyros-overview',
    detail: null,
  },
  {
    name: 'Mycelium',
    tagline: 'Distributed AI mesh · substitute-on-failure inference.',
    description: 'Six workers pool compute for one Gemma-4-26B chat. When workers drop, substitute-on-failure dispatch keeps generation continuing — Day-27 cryptographic reduction-to-practice. R2I-aligned MOSA surface with 50-endpoint OpenAPI 3.1 published. 41 of 44 in-scope NIST 800-53 controls met with file-path traceability. mTLS on worker channel, HMAC-chained per-request audit log.',
    stat: '250K + 19K', statLabel: 'Go + Python LOC',
    status: 'live', statusLabel: 'v1.0.0 · evaluator outreach in motion',
    repoUrl: 'https://github.com/thornveil-ai/mycelium-overview',
    repoLabel: 'thornveil-ai/mycelium-overview',
    detail: '/mycelium',
  },
  {
    name: 'RigRun',
    tagline: 'Professional AI chat · classification-gated routing.',
    description: 'Three apps (desktop, mobile, web) on one Go backend. The type system excludes cloud routing for CUI+ queries. 44 NIST 800-53 controls implemented as discrete code paths. 8-signal confidence pipeline. IR-9 spillage detection with Unicode normalization + entropy thresholding.',
    stat: '496K', statLabel: 'LOC · 6,950 tests',
    status: 'live', statusLabel: 'v0.9 · federal evaluation post-DD-214',
    repoUrl: 'https://github.com/thornveil-ai/rigrun-overview',
    repoLabel: 'thornveil-ai/rigrun-overview',
    detail: null,
  },
  {
    name: 'HawkStack',
    tagline: 'Compute-aware neural-architecture topology.',
    description: 'Topology-driven recipe that turns (dataset, domain) into (architecture, training config) and produces sub-million-parameter models that match SOTA in their weight class. 15 verified zoo checkpoints across IRST (synthetic + real), sonar, PCB defect, histopathology, and thermal drone. 16-run power-law scaling fit on NUDT-SIRST (R²=0.9895). 33-page topology paper preparing arXiv submission.',
    stat: '15', statLabel: 'zoo checkpoints · 5 domains',
    status: 'warn', statusLabel: 'v0.3.0 · paper preparing arXiv',
    repoUrl: 'https://github.com/thornveil-ai/hawkstack-paper',
    repoLabel: 'thornveil-ai/hawkstack-paper',
    detail: null,
  },
  {
    name: 'Meridian',
    tagline: 'Memory-safe Rust flight-control firmware.',
    description: 'From-scratch ArduPilot/PX4 alternative on STM32 H7 / F4 / F7. Phase 10 trade-secret primitives no other autopilot ships: ed25519-signed airworthiness attestation, RC hijack / GPS spoof / mag jam adversarial-detection failsafes, Find My Drone beacon, self-learning vehicle dynamics ID, Black Box event taxonomy. ~29K lines of parity-audit notes against 154 ArduPilot libraries (47K total documentation). Hardware bring-up active on MatekH743 and Cube Orange Plus.',
    stat: '98K + 60', statLabel: 'Rust LOC · crates',
    status: 'live', statusLabel: 'hardware bring-up active',
    repoUrl: 'https://github.com/thornveil-ai/meridian-core',
    repoLabel: 'thornveil-ai/meridian-core',
    detail: null,
  },
  {
    name: 'Canopy',
    tagline: 'Multi-modal counter-UAS situational awareness.',
    description: 'RF + acoustic + thermal + Remote ID + ADS-B fusion. Kalman tracking, Dempster-Shafer evidence fusion and bearing-intersection geolocation have been tested. With mesh networking and the decision engine scaffolded and ML classifiers still stubbed, this Phase 0 project is intended to replace DragonOS/WarDragon with an open architecture that supports mesh networking. Hardware tiers from $270 to $1,650.',
    stat: 'Phase 0', statLabel: 'architecture validated',
    status: 'warn', statusLabel: 'phase 0 · integration pending',
    repoUrl: 'https://github.com/thornveil-ai/canopy-preview',
    repoLabel: 'thornveil-ai/canopy-preview',
    detail: null,
  },
  {
    name: 'Auspex',
    tagline: 'AI red team gated by Signet · federal-only.',
    description: 'The model proposes. Signet authorizes. Auspex executes only what is allowed. Scope-as-code engagement compilation. 13 standard authority checks at the Signet gate. HMAC-chained per-engagement audit log with RFC 3161 trusted-timestamp anchoring. Validated end-to-end on adversarial Active Directory takeover with auditable replay package. Federal-gated, EAR ECCN 4D004.',
    stat: '66K + 5K', statLabel: 'Go LOC · Python SFT',
    status: 'live', statusLabel: 'v0.5.3 · federal edition',
    repoUrl: 'https://github.com/thornveil-ai/auspex-contact',
    repoLabel: 'thornveil-ai/auspex-contact',
    detail: null,
  },
  {
    name: 'Navigator',
    tagline: 'Internal agent-production pipeline.',
    description: 'Internal AI ops infrastructure. A 14-step factory pipeline (decompose → multi-pass system prompt → tool selection → Opus calibration → 5-probe adversarial stress test → adversarial hardening → functional tests → quality gate) produces 9 production domain-expert agents covering federal-doctrine drafting, security review, sprint planning, technical writing, and research. 80 MCP-exposed tools across 9 domains. Not for external sale.',
    stat: '40K + 9', statLabel: 'LOC · production agents',
    status: 'live', statusLabel: 'internal · federal agent pack candidate',
    repoUrl: null,
    repoLabel: null,
    detail: null,
  },
];
---

<BaseLayout
  title="Systems | Thornveil"
  description="Ten engineering systems with audit-verified codebase metrics. Public companion repositories for review. Built solo while active-duty USMC since January 2026."
>
  <!-- HERO -->
  <section class="tv-section pt-s-11">
    <div class="tv-container">
      <h1 class="tv-h1 mt-s-3 reveal reveal-delay-1" style="max-width: 22ch;">
        Ten engineering systems. One sovereign AI stack.
      </h1>
      <p class="text-step-1 text-text-2 mt-s-5 reveal reveal-delay-2" style="max-width: 64ch;">
        Each tile below carries audit-verified codebase metrics and a link to the public companion repository
        for review. Source for the proprietary systems lives behind licensing; the public companions hold
        marketing-grade documentation, architecture overviews, and API contracts that evaluators can read.
      </p>
      <div class="mt-s-6 flex flex-wrap gap-s-3 reveal reveal-delay-3">
        <a href="/#pick-your-track" class="tv-btn tv-btn--primary plausible-event-name=Systems+Walkthrough">
          Schedule a walkthrough →
        </a>
        <a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="tv-btn tv-btn--secondary plausible-event-name=Browse+GitHub">
          Browse the GitHub org ↗
        </a>
      </div>
      <nav id="systems-index" class="section-nav mt-s-7" aria-label="Systems on this page">
        <p class="font-mono text-step--1 text-text-3">On this page</p>
        <ul>
          {systems.map(s => <li><a href={`#${s.name.toLowerCase()}`}>{s.name}</a></li>)}
          <li><a href="#build-context">Build context</a></li>
          <li><a href="#reach-out">Reach out</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- SYSTEMS GRID -->
  <section class="tv-section pt-0">
    <div class="tv-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-s-5">
        {systems.map((s, i) => {
          const Viz = vizFor[s.name];
          const sysRef = `SYS.${String(i + 1).padStart(2, '0')}`;
          return (
          <article id={s.name.toLowerCase()} tabindex="-1" aria-labelledby={`${s.name.toLowerCase()}-title`} class={`system-card tv-tile reveal reveal-delay-${Math.min(i + 1, 4)} flex flex-col`}>
            <h2 id={`${s.name.toLowerCase()}-title`} class="text-step-2 mb-s-2" style="font-variation-settings: 'wdth' 125;">{s.name}</h2>
            <p class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 mb-s-4">{s.tagline}</p>
            <p class="text-step-0 text-text-2 mb-s-5 max-w-prose">{s.description}</p>
            <!-- top row: status pill | mono stat (per design spec) -->
            <div class="flex items-start justify-between gap-s-4 mb-s-4 flex-wrap">
              <span class={`tv-pill ${s.status === 'live' ? 'tv-pill--live' : 'tv-pill--warn'}`}>
                {s.statusLabel}
              </span>
              <span class="font-mono tabular text-step--1 tracking-[0.10em] uppercase text-text-3">
                {s.stat}<span class="text-text-3"> {s.statLabel}</span>
              </span>
            </div>

            <!-- Bespoke visualization in an instrument-panel frame: dot-grid
                 background, corner registration marks, top-strip LIVE LED +
                 ref ID, bottom-strip tick scale. -->
            {Viz ? (
              <div data-system-viz class="mb-s-5 -mx-s-3 viz-panel" style="border: 1px solid var(--line); border-radius: 2px;">
                <div class="viz-chrome"></div>
                <div class="viz-strip">
                  <span class="viz-led">{s.status === 'live' ? 'LIVE' : 'DEV'}</span>
                  <span>{sysRef} · {s.name.toUpperCase()}</span>
                </div>
                <Viz />
                <div class="viz-strip-bottom"><div class="viz-ticks"></div></div>
              </div>
            ) : null}
            {s.name === 'Mycelium' && (
              <p class="text-step--1 text-text-2 mb-s-5">
                Illustrative telemetry (not a live feed): alive 06 / 06 · pulses/sec 17.4 · continuity 100%.
              </p>
            )}
            {s.name === 'Pyros' && (
              <p class="text-step--1 text-text-2 mb-s-5">
                Control loop: PID → Forecaster (Holt) → Bandit (UCB1) → Orchestrator (ε-greedy) → feedback.
              </p>
            )}

            <!-- footer row -->
            <div class="border-t border-line pt-s-4 mt-auto flex flex-wrap items-center gap-x-s-4 gap-y-s-3">
              {s.detail ? (
                <a href={s.detail} class="font-mono text-step--1 tracking-[0.10em] uppercase text-signal-text hover:text-text">
                  Mycelium mechanism and test status →
                </a>
              ) : null}
              {s.repoUrl ? (
                <a href={s.repoUrl} target="_blank" rel="noopener" class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3 hover:text-text">
                  {s.repoLabel} ↗
                </a>
              ) : (
                <span class="font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">
                  internal-only
                </span>
              )}
              <a href="#systems-index" class="back-to-index text-step--1 text-text-3">Back to systems ↑</a>
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- BUILD CONTEXT -->
  <section id="build-context" tabindex="-1" class="tv-section pt-0">
    <div class="tv-container max-w-3xl text-center">
      <h2 class="tv-h2 mt-s-3 mb-s-5 reveal reveal-delay-1">Built solo while on active duty</h2>
      <div class="space-y-s-4 text-step-0 text-text-2 reveal reveal-delay-2">
        <p>
          First commit on the oldest repo: January 12, 2026. Combined ~{m.portfolio.totalLOC} LOC across Go,
          Rust, Python, TypeScript, and Dart by May 2026. Built solo while active-duty USMC. Direct contracts
          open {m.company.directContractsOpen} (DD-214). Soft engagements and co-founder applications open
          now.
        </p>
        <p>
          See <a href="/about" class="text-signal-text underline underline-offset-4 decoration-1">/about</a> for the founder narrative and
          {' '}<a href="/cofounder" class="text-signal-text underline underline-offset-4 decoration-1">/cofounder</a> for the seat we're looking to fill.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="reach-out" tabindex="-1" class="tv-section pt-0" style="background: var(--bg-inset); border-top: 1px solid var(--line);">
    <div class="tv-container max-w-2xl text-center">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Review the work. Reach out.</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mx-auto reveal reveal-delay-2" style="max-width: 52ch;">
        Federal program offices, defense primes, evaluators, co-founder candidates — direct line.
      </p>
      <div class="mt-s-7 flex flex-wrap gap-s-3 justify-center reveal reveal-delay-3">
        <a href="mailto:jesse@thornveil.ai" class="tv-btn tv-btn--primary">jesse@thornveil.ai</a>
        <a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="tv-btn tv-btn--secondary">github.com/thornveil-ai ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1, h2, p, .tv-btn { overflow-wrap: anywhere; }
  .section-nav { border-block: 1px solid var(--line); padding-block: var(--s-4); }
  .section-nav ul { display: flex; flex-wrap: wrap; gap: 0 var(--s-4); margin-top: var(--s-2); }
  .section-nav a, .back-to-index { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 4px; }
  .section-nav a { color: var(--signal-text); }
  .system-card { min-width: 0; overflow-wrap: anywhere; }
  .system-card .tv-pill { white-space: normal; }
  .system-card .viz-panel { flex-shrink: 0; }
  .system-card > div:last-child > a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 767px) {
    .system-card .viz-panel { height: 165px; margin-inline: 0; }
  }
</style>

<style is:global>
  /* Static HTML first: no-JS visitors keep the diagrams, not continuous motion.
     Scope includes the panel's animated LED pseudo-element, not just the SVG. */
  [data-system-viz]:not([data-viz-managed]) *,
  [data-system-viz]:not([data-viz-managed]) *::before,
  [data-system-viz]:not([data-viz-managed]) *::after {
    animation: none !important;
  }
  [data-system-viz][data-viz-managed]:not([data-viz-active]) *,
  [data-system-viz][data-viz-managed]:not([data-viz-active]) *::before,
  [data-system-viz][data-viz-managed]:not([data-viz-active]) *::after {
    animation-play-state: paused !important;
  }
  [data-system-viz]:not([data-viz-managed]) .au-hash-elem,
  [data-system-viz]:not([data-viz-managed]) .au-allow-recover,
  [data-system-viz]:not([data-viz-managed]) .myc-hud-event-block,
  [data-system-viz]:not([data-viz-managed]) .myc-rising,
  [data-system-viz]:not([data-viz-managed]) .myc-rising-edge {
    opacity: 1;
  }
  [data-system-viz]:not([data-viz-managed]) .au-cursor,
  [data-system-viz]:not([data-viz-managed]) .myc-pulse {
    opacity: 0;
  }
</style>

<script>
  import { observeSystemDiagrams } from '../components/system-viz/visibility';

  let cleanup = () => {};
  function initializeDiagrams() {
    cleanup();
    cleanup = observeSystemDiagrams();
  }
  document.addEventListener('astro:page-load', initializeDiagrams);
  document.addEventListener('astro:before-swap', () => {
    cleanup();
    cleanup = () => {};
  });
  // Also supports a direct load without Astro's client router.
  initializeDiagrams();
</script>
