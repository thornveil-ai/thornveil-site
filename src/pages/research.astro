---
import BaseLayout from '../layouts/BaseLayout.astro';

const papers = [
  { title: 'Selective-Buffer Streaming Safety for AI Coding Agents',                                        category: 'cs.CR', pages: 8, file: 'paper1-safety' },
  { title: 'Zeroth-Order Preference Optimization on 100B+ Quantized MoE Models via Live Inference API',     category: 'cs.LG', pages: 7, file: 'paper2-training' },
  { title: 'Compressed KV Cache Attention as a Plugin Backend',                                             category: 'cs.DC', pages: 6, file: 'paper3-turboquant' },
  { title: 'Speculative Decoding Fails on Sparse MoE: A Negative Result and Practical Multi-Model Cascade', category: 'cs.SE', pages: 6, file: 'paper4-cascade' },
  { title: 'RigRun: Complete Local AI Infrastructure on a Single GPU',                                      category: 'cs.AI', pages: 5, file: 'paper5-system' },
];

const ipSubsystems = [
  { system: 'Mycelium',  subsystem: 'Substitute-on-failure MoE expert dispatch',                                              evidence: 'Day-27 RTP with HMAC-chained audit log, 2026-05-08' },
  { system: 'Auspex',    subsystem: 'Scope-as-code engagement compilation + 13-check Signet gate',                            evidence: 'Autonomous AD takeover with auditable replay, 2026-05-16' },
  { system: 'RigRun',    subsystem: 'Compile-time classification-gated routing with cross-domain guard',                       evidence: 'Type-system enforced · 44 NIST 800-53 controls implemented' },
  { system: 'RigRun',    subsystem: '8-signal confidence pipeline with adversarial self-audit',                                evidence: '~4,220 LOC across 8 signals · cross-app parity in Go/Dart/TS' },
  { system: 'Signet',    subsystem: 'HMAC-chained tamper-evident audit ledger with RFC 3161 anchoring',                        evidence: '2,400 LOC across chain.py + verifier.py + compactor.py · 7-state break taxonomy' },
  { system: 'HawkStack', subsystem: 'Compute-aware neural topology recipe (3-parameter)',                                       evidence: '15 verified zoo checkpoints · R²=0.9895 power-law fit on NUDT-SIRST' },
  { system: 'Pyros',     subsystem: '24-layer adaptive control loop (PID + Holt + UCB1 + ε-greedy)',                            evidence: 'Race-clean CI across Linux/macOS/Windows · PAVA calibration validated vs sklearn' },
  { system: 'Meridian',  subsystem: 'Phase 10 trade-secret primitives — attest, secdef, beacon, vehicle-id, log',               evidence: '~5,500 LOC across 5 crates · not shipped in ArduPilot or PX4' },
  { system: 'Navigator', subsystem: '14-step agent-production pipeline with Opus calibration + 5-probe adversarial hardening', evidence: '9 production domain-expert agents generated by the pipeline' },
];

const totals = [
  { value: '10', label: 'engineering systems' },
  { value: '5',  label: 'technical reports written' },
  { value: '2',  label: 'Apache-2.0 OSS releases' },
];
---

<BaseLayout
  title="Research | Thornveil"
  description="Five research papers documenting algorithms behind Thornveil's 10-system portfolio. Trade-secret-grade subsystems with cryptographic reduction-to-practice evidence."
>
  <!-- HERO -->
  <section class="tv-section pt-s-11">
    <div class="tv-container">
      <h1 class="tv-h1 mt-s-3 reveal reveal-delay-1" style="max-width: 22ch;">Evidence, not adjectives.</h1>
      <p class="text-step-1 text-text-2 mt-s-5 reveal reveal-delay-2" style="max-width: 64ch;">
        Every claim is backed by working code, measured benchmarks, and where appropriate cryptographically
        auditable reduction-to-practice. Five technical reports below — one preparing arXiv submission.
        Source on
        {' '}<a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="text-signal-text underline underline-offset-4 decoration-1">github.com/thornveil-ai</a>.
      </p>
    </div>
  </section>

  <!-- TECHNICAL REPORTS -->
  <section class="tv-section pt-0">
    <div class="tv-container">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">Technical reports</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mb-s-6 reveal reveal-delay-2" style="max-width: 64ch;">
        Internal write-ups documenting the algorithms behind Thornveil's systems. Not yet peer-reviewed;
        HawkStack topology paper is preparing arXiv submission. Read at your own pace.
      </p>
      <div class="space-y-s-3">
        {papers.map((p, i) => (
          <a
            href={`/papers/${p.file}.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class={`tv-tile reveal reveal-delay-${Math.min(i + 1, 4)} flex items-start justify-between gap-s-4 flex-wrap`}
          >
            <div class="flex-1 min-w-0">
              <h3 class="text-step-1 text-text mb-s-2" style="font-variation-settings: 'wdth' 125;">{p.title}</h3>
              <div class="flex items-center gap-s-4 font-mono text-step--1 tracking-[0.10em] uppercase text-text-3">
                <span class="tv-pill tv-pill--ghost">{p.category}</span>
                <span class="tabular">{p.pages} pages</span>
                <span>J. Morgan · 2026</span>
              </div>
            </div>
            <span class="tv-pill tv-pill--live shrink-0">PDF ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- IP — what's actually defensible -->
  <section class="tv-section pt-0">
    <div class="tv-container">
      <h2 class="tv-h2 mt-s-3 reveal reveal-delay-1">What's actually defensible.</h2>
      <p class="text-step-0 text-text-2 mt-s-4 mb-s-6 reveal reveal-delay-2" style="max-width: 64ch;">
        Each Thornveil system carries one or more subsystems where the engineering work
        materially differentiates it from open-source alternatives. Named subsystem, the differentiator,
        and the empirical evidence behind each.
      </p>

      <div class="space-y-s-3 reveal reveal-delay-2">
        {ipSubsystems.map((s) => (
          <article class="tv-tile">
            <div class="flex items-start gap-s-4 flex-wrap">
              <span class="tv-pill tv-pill--ghost shrink-0">{s.system}</span>
              <div class="flex-1 min-w-0">
                <h3 class="text-step-1 text-text mb-s-2" style="font-variation-settings: 'wdth' 125;">{s.subsystem}</h3>
                <p class="font-mono text-step--1 tracking-[0.08em] uppercase text-text-3">{s.evidence}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="grid grid-cols-3 gap-s-5 mt-s-9 reveal reveal-delay-3">
        {totals.map((t) => (
          <div class="text-center">
            <div class="font-mono tabular text-step-3 text-signal-text leading-none">{t.value}</div>
            <div class="tv-stat-label">{t.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
