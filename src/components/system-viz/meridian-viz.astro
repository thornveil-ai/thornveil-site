---
/**
 * Meridian viz — flight-control loop with GPS anomaly detection.
 *
 * SENSORS (GPS / IMU / MAG) → ESTIMATOR → CONTROLLER → MOTORS → VEHICLE → feedback.
 * Every ~6s the GPS input flashes amber and a "FAILSAFE · GPS ANOMALY · CONTAINED"
 * annotation appears for ~1.8s before resolving. (Capability disclosed at the
 * "we noticed and contained it" level; specific mitigation kept proprietary.)
 */
const W = 500;
const H = 220;
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  width="100%"
  height="100%"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  role="presentation"
  style="display:block;"
>
  <style>
    .mer-mono     { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
    .mer-block    { font-size: 10px; letter-spacing: 0.10em; font-weight: 500; }
    .mer-tag      { font-size: 9px; letter-spacing: 0.15em; }
    .mer-fs       { font-size: 10px; letter-spacing: 0.15em; font-weight: 500; }
    .mer-gps {
      animation: mer-gps-flash 7s ease-in-out infinite;
    }
    @keyframes mer-gps-flash {
      0%, 55%   { stroke: var(--signal-line); fill: rgba(74,110,125,0.10); }
      57%, 78%  { stroke: #E8B341; fill: rgba(232,179,65,0.18); }
      80%, 100% { stroke: var(--signal-line); fill: rgba(74,110,125,0.10); }
    }
    .mer-failsafe {
      opacity: 0;
      animation: mer-failsafe 7s ease-in-out infinite;
    }
    @keyframes mer-failsafe {
      0%, 55%   { opacity: 0; }
      58%, 80%  { opacity: 1; }
      84%, 100% { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mer-gps, .mer-failsafe { animation: none; }
    }
  </style>

  <!-- Header -->
  <text x="24" y="32" class="mer-mono mer-tag" fill="var(--text-3)">
    MEMORY-SAFE FLIGHT-CONTROL · STM32 H7 / F4 / F7
  </text>

  <!-- Sensor stack -->
  <g class="mer-gps">
    <rect x="24" y="60" width="64" height="20" rx="2" stroke-width="1" />
  </g>
  <text x="56" y="74" text-anchor="middle" class="mer-mono mer-block" fill="var(--text)">GPS</text>

  <rect x="24" y="85" width="64" height="20" rx="2"
        fill="rgba(74,110,125,0.10)" stroke="var(--signal-line)" stroke-width="1" />
  <text x="56" y="99" text-anchor="middle" class="mer-mono mer-block" fill="var(--text)">IMU</text>

  <rect x="24" y="110" width="64" height="20" rx="2"
        fill="rgba(74,110,125,0.10)" stroke="var(--signal-line)" stroke-width="1" />
  <text x="56" y="124" text-anchor="middle" class="mer-mono mer-block" fill="var(--text)">MAG</text>

  <!-- Pipeline blocks -->
  {[
    { x: 116, w: 70, label: 'ESTIMATOR',  sub: 'EKF'        },
    { x: 200, w: 84, label: 'CONTROLLER', sub: 'PID + Adv'  },
    { x: 300, w: 60, label: 'MOTORS',     sub: 'PWM'        },
    { x: 376, w: 100, label: 'VEHICLE',   sub: 'STM32 H7'   },
  ].map((b) => (
    <g>
      <rect x={b.x} y="85" width={b.w} height="20" rx="2"
            fill="rgba(74,110,125,0.10)" stroke="var(--signal-line)" stroke-width="1" />
      <text x={b.x + b.w / 2} y="99" text-anchor="middle"
            class="mer-mono mer-block" fill="var(--text)">{b.label}</text>
      <text x={b.x + b.w / 2} y="118" text-anchor="middle"
            class="mer-mono mer-tag" fill="var(--text-3)">{b.sub}</text>
    </g>
  ))}

  <!-- Sensor→Estimator wiring -->
  <line x1="88" y1="70"  x2="116" y2="92"  stroke="var(--signal-line)" stroke-width="0.75" />
  <line x1="88" y1="95"  x2="116" y2="95"  stroke="var(--signal-line)" stroke-width="0.75" />
  <line x1="88" y1="120" x2="116" y2="98"  stroke="var(--signal-line)" stroke-width="0.75" />

  <!-- Forward chain -->
  <line x1="186" y1="95" x2="200" y2="95" stroke="var(--signal-line)" stroke-width="1" />
  <line x1="284" y1="95" x2="300" y2="95" stroke="var(--signal-line)" stroke-width="1" />
  <line x1="360" y1="95" x2="376" y2="95" stroke="var(--signal-line)" stroke-width="1" />

  <!-- Feedback loop -->
  <path d="M 426 118 L 426 142 L 116 142 L 116 108"
        stroke="var(--signal-line)" stroke-width="0.75" fill="none"
        stroke-dasharray="2 3" opacity="0.6" />

  <!-- FAILSAFE annotation — capability claim, no implementation -->
  <g class="mer-failsafe" transform="translate(116, 156)">
    <rect x="0" y="0" width="240" height="22" rx="2"
          fill="rgba(232,179,65,0.18)" stroke="#E8B341" stroke-width="1" />
    <text x="120" y="15" text-anchor="middle" class="mer-mono mer-fs" fill="#E8B341">
      FAILSAFE · GPS ANOMALY · CONTAINED
    </text>
  </g>

  <!-- Footer -->
  <text x="24" y={H - 14} class="mer-mono mer-tag" fill="var(--text-3)">
    PHASE 10 ADVERSARIAL DETECTION · 98K LOC · 60 CRATES
  </text>
</svg>
