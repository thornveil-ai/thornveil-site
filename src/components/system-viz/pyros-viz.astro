---
/**
 * Pyros viz — 4-block adaptive control loop with traversing pulse.
 *
 * PID → FORECASTER → BANDIT → ORCHESTRATOR → feedback to PID. A single token
 * pulse continuously circulates the loop, demonstrating closed-loop adaptive
 * control without exposing the 24-subsystem internals.
 */
const W = 500;
const H = 220;
const bw = 88;
const bh = 44;
const by = 76;
const blocks = [
  { x: 24,  label: 'PID',          sub: 'homeostasis' },
  { x: 138, label: 'FORECASTER',   sub: 'Holt' },
  { x: 252, label: 'BANDIT',       sub: 'UCB1' },
  { x: 366, label: 'ORCHESTRATOR', sub: 'ε-greedy' },
];
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  width="100%"
  height="100%"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  role="presentation"
  style="display:block;"
>
  <style>
    .pyros-mono     { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
    .pyros-label    { font-size: 11px; letter-spacing: 0.10em; font-weight: 500; }
    .pyros-sub      { font-size: 9px; letter-spacing: 0.15em; }
    .pyros-pulse {
      animation: pyros-loop 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      fill: #B4D2DE;
      filter: drop-shadow(0 0 8px rgba(180,210,222,0.8));
    }
    @keyframes pyros-loop {
      0%   { transform: translate(68px, 98px); }
      22%  { transform: translate(182px, 98px); }
      45%  { transform: translate(296px, 98px); }
      68%  { transform: translate(410px, 98px); }
      78%  { transform: translate(470px, 160px); }
      88%  { transform: translate(68px, 160px); }
      100% { transform: translate(68px, 98px); }
    }
    @media (prefers-reduced-motion: reduce) { .pyros-pulse { animation: none; } }
  </style>

  <!-- Header -->
  <text x="24" y="32" class="pyros-mono pyros-sub" fill="var(--text-3)">
    24-LAYER ADAPTIVE CONTROL · 7 PILLARS
  </text>
  <text x={W - 24} y="32" text-anchor="end"
        class="pyros-mono pyros-sub" fill="var(--signal-text)">
    PAVA-CALIBRATED
  </text>

  <!-- Blocks -->
  {blocks.map((b) => (
    <g>
      <rect x={b.x} y={by} width={bw} height={bh}
            fill="rgba(74,110,125,0.10)" stroke="var(--signal-line)"
            stroke-width="1" rx="2" />
      <text x={b.x + bw / 2} y={by + 20} text-anchor="middle"
            class="pyros-mono pyros-label" fill="var(--signal-text)">
        {b.label}
      </text>
      <text x={b.x + bw / 2} y={by + 34} text-anchor="middle"
            class="pyros-mono pyros-sub" fill="var(--text-3)">
        {b.sub}
      </text>
    </g>
  ))}

  <!-- Forward arrows -->
  {blocks.slice(0, -1).map((b, i) => {
    const x1 = b.x + bw;
    const x2 = blocks[i + 1].x;
    return (
      <g>
        <line x1={x1} y1={by + bh / 2} x2={x2} y2={by + bh / 2}
              stroke="var(--signal-line)" stroke-width="1" />
        <polygon
          points={`${x2 - 4},${by + bh / 2 - 3} ${x2},${by + bh / 2} ${x2 - 4},${by + bh / 2 + 3}`}
          fill="var(--signal-line)" />
      </g>
    );
  })}

  <!-- Feedback loop -->
  <path d={`M ${blocks[3].x + bw} ${by + bh / 2} L ${W - 24} ${by + bh + 28} L 24 ${by + bh + 28} L 24 ${by + bh / 2}`}
        stroke="var(--signal-line)" stroke-width="1" fill="none"
        stroke-dasharray="2 4" opacity="0.7" />
  <polygon points={`28,${by + bh / 2 + 4} 24,${by + bh / 2} 20,${by + bh / 2 + 4}`}
           fill="var(--signal-line)" />

  <!-- Feedback path label -->
  <text x={W / 2} y={by + bh + 22} text-anchor="middle"
        class="pyros-mono pyros-sub" fill="var(--text-3)">
    OBSERVE → DECIDE → ACT
  </text>

  <!-- Traversing pulse -->
  <circle class="pyros-pulse" cx="0" cy="0" r="4" />

  <!-- Footer -->
  <text x="24" y={H - 14} class="pyros-mono pyros-sub" fill="var(--text-3)">
    PID + HOLT + UCB1 + ε-GREEDY · RACE-CLEAN ACROSS LINUX/MACOS/WINDOWS
  </text>
</svg>
