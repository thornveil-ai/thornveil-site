---
const navLinks = [
  { href: '/systems',  label: 'Systems' },
  { href: '/defense',  label: 'Defense' },
  { href: '/research', label: 'Research' },
  { href: '/about',    label: 'About' },
  { href: '/contact',  label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<header
  id="nav"
  class="fixed left-0 right-0 z-50 transition-colors duration-fast ease-out nav-with-momentum"
  style="background: transparent; border-bottom: 1px solid transparent;"
>
  <nav class="tv-container flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center" aria-label="Thornveil — home">
      <img
        src="/logo-horizontal-white.png"
        alt="Thornveil"
        class="h-12 md:h-16 w-auto"
      />
    </a>

    <div class="hidden md:flex items-center gap-7">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="tv-nav-link"
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <button
      id="mobile-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
      type="button"
    >
      <span class="block w-5 h-px transition-all duration-fast ease-out origin-center bg-text-2" id="bar1"></span>
      <span class="block w-5 h-px transition-all duration-fast ease-out bg-text-2" id="bar2"></span>
      <span class="block w-5 h-px transition-all duration-fast ease-out origin-center bg-text-2" id="bar3"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    inert
    aria-hidden="true"
    class="md:hidden overflow-hidden max-h-0 transition-all duration-slow ease-out"
    style="background: rgba(5,7,8,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line);"
  >
    <div class="tv-container py-4 flex flex-col gap-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="tv-nav-link"
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .nav-with-momentum {
    top: 28px;
  }
  @media (max-width: 640px) {
    .nav-with-momentum { top: 24px; }
  }
</style>

<script>
  let cleanupNavigation = () => {};
  function bindNavigation() {
  cleanupNavigation();
  const controller = new AbortController();
  const { signal } = controller;
  const nav = document.getElementById('nav');
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.style.background = 'rgba(5,7,8,0.78)';
      nav.style.backdropFilter = 'blur(12px)';
      nav.style.borderBottomColor = 'var(--line)';
    } else {
      nav.style.background = 'transparent';
      nav.style.backdropFilter = 'none';
      nav.style.borderBottomColor = 'transparent';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true, signal });
  onScroll();

  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  let open = false;
  const desktop = window.matchMedia('(min-width: 768px)');
  let lastFocused = null;
  document.addEventListener('focusin', (event) => {
    lastFocused = nav?.contains(event.target) ? event.target : null;
  }, { signal });

  function setOpen(next, restoreFocus = false) {
    open = next && !desktop.matches;
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) {
      menu.inert = !open;
      menu.setAttribute('aria-hidden', String(!open));
    }
    if (open && menu) {
      menu.style.maxHeight = menu.scrollHeight + 'px';
      bar1?.classList.add('rotate-45', 'translate-y-[3px]');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-[3px]');
    } else if (menu) {
      menu.style.maxHeight = '0';
      bar1?.classList.remove('rotate-45', 'translate-y-[3px]');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-[3px]');
    }
    if (restoreFocus) toggle?.focus();
  }
  toggle?.addEventListener('click', () => setOpen(!open), { signal });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && open) {
      event.preventDefault();
      setOpen(false, true);
    }
  }, { signal });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      setOpen(false, true);
    }, { signal });
  });
  desktop.addEventListener('change', () => {
    // The browser may blur a newly display:none link before the media event.
    const focused = document.activeElement === document.body ? lastFocused : document.activeElement;
    if (desktop.matches && (menu?.contains(focused) || focused === toggle)) {
      const href = focused?.getAttribute('href');
      const links = nav?.querySelectorAll('nav a');
      const target = Array.from(links ?? []).find((link) => link.getAttribute('href') === href);
      (target ?? links?.[0])?.focus();
    } else if (!desktop.matches && focused instanceof HTMLElement && nav?.contains(focused) && focused.closest('.hidden.md\\:flex')) {
      toggle?.focus();
    }
    setOpen(false);
  }, { signal });
  setOpen(false);
  cleanupNavigation = () => controller.abort();
  }
  bindNavigation();
  document.addEventListener('astro:page-load', bindNavigation);
  document.addEventListener('astro:before-swap', () => cleanupNavigation());
</script>
