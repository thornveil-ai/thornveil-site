---
import metrics from '../data/metrics.json';

const currentYear = new Date().getFullYear();
const naics = metrics.company.naics.join(', ');
const a11y = metrics.accessibility;
const buildDate = new Date().toISOString().slice(0, 10);
---

<footer class="border-t border-line mt-s-10">
  <div class="tv-container py-s-5 md:py-s-7">
    <div class="grid grid-cols-1 gap-s-4 md:grid-cols-3 md:gap-s-6 items-start">
      <!-- Wordmark + tagline -->
      <div class="flex items-center justify-between gap-s-3 md:block">
        <a href="/" class="inline-flex min-h-11 md:min-h-0 items-center" aria-label="Thornveil — home">
          <img src="/logo-horizontal-white.png" alt="Thornveil" class="h-10 w-auto md:h-12" />
        </a>
        <p class="font-mono text-[var(--step--1)] tracking-[0.10em] uppercase text-text-3 text-right md:text-left md:mt-s-3">
          Sovereign AI infrastructure
        </p>
      </div>

      <!-- Link columns -->
      <nav class="grid grid-cols-2 gap-x-s-3 gap-y-1 md:flex md:flex-wrap md:gap-x-s-6 md:gap-y-s-2" aria-label="Footer">
        <a href="/systems"   class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">Systems</a>
        <a href="/defense"   class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">Defense</a>
        <a href="/research"  class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">Research</a>
        <a href="/cofounder" class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">Co-founder</a>
        <a href="/about"     class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">About</a>
        <a href="/contact"   class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">Contact</a>
        <a href="/privacy"   class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">Privacy</a>
      </nav>

      <!-- External links -->
      <div class="border-t border-line pt-s-2 grid grid-cols-2 gap-x-s-3 gap-y-1 md:border-0 md:pt-0 md:flex md:flex-wrap md:gap-x-s-6 md:gap-y-s-2 md:justify-end">
        <a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">GitHub ↗</a>
        <a href="https://www.linkedin.com/company/thornveil-llc" target="_blank" rel="noopener" class="tv-nav-link flex min-h-11 items-center py-2 md:min-h-0 md:py-0">LinkedIn ↗</a>
        <a href="mailto:jesse@thornveil.ai" class="tv-nav-link col-span-2 flex min-h-11 items-center break-all py-2 md:col-auto md:min-h-0 md:py-0">jesse@thornveil.ai</a>
      </div>
    </div>

    <div class="tv-rule my-s-4 md:my-s-6" role="separator"></div>

    <!-- Telemetry footer: registry + compliance-claim line + build date -->
    <div class="flex flex-col items-start justify-between gap-s-2 font-mono text-[var(--step--1)] tracking-[0.12em] uppercase text-text-3 md:flex-row md:flex-wrap md:items-center md:gap-s-3">
      <p>&copy; {currentYear} {metrics.company.name} · {metrics.company.city} · NAICS {naics}</p>
      <p>508 {a11y.section508} · Lighthouse {a11y.lighthouseTarget}+ · last updated {buildDate}</p>
    </div>

    <!-- Transmission terminator — the "end of transmission" mono signature
         at the absolute bottom. Subtle hairline-flanked end marker. -->
    <div
      class="hidden md:flex items-center gap-s-3 mt-s-5 font-mono text-text-3"
      style="font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;"
      aria-hidden="true"
    >
      <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 8px rgba(143, 179, 196, 0.8);"></span>
      <span>END TRANSMISSION</span>
      <span style="flex: 1; height: 1px; background: linear-gradient(to right, var(--signal-line), transparent);"></span>
    </div>
  </div>
</footer>

<style>
  footer .tv-nav-link { overflow-wrap: anywhere; min-width: 0; }
  footer p { overflow-wrap: anywhere; }
  @media (max-width: 767px) {
    footer { margin-top: var(--s-8); }
    footer .tv-container > .grid > :first-child { flex-wrap: wrap; }
    footer .tv-container > .grid > :first-child p { text-align: left; }
    footer .font-mono { font-size: var(--shell-meta-size); letter-spacing: 0.04em; }
  }
</style>
