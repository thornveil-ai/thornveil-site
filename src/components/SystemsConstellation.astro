---
/**
 * SystemsConstellation — the 10-system dependency graph.
 *
 * Wow moment #2 of the homepage. Mycelium's hero is wow #1; this is the
 * "and these other nine are real too" moment. Each system is a navy-shielded
 * node; edges are declared dependencies (Signet → Auspex, Pyros → RigRun,
 * HawkStack → Meridian, etc.).
 *
  * Hover previews a system; the equivalent button list supports keyboard
  * and touch selection. The readout describes directed relationships in text.
 * Reduced-motion: hover interactions still work; only the ambient pulse
 * animations are stilled.
 */
import graph from '../data/system-graph.json';

const W = 1200;
const H = 520;
const nodes = graph.nodes;
const edges = graph.edges;

// Pre-compute a lookup so we can pull node positions inline.
const posById = Object.fromEntries(nodes.map((n) => [n.id, n]));
const relationships = (id: string) => edges
  .filter((e) => e.from === id || e.to === id)
  .map((e) => `${posById[e.from].name} → ${posById[e.to].name} (${e.label})`)
  .join('; ') || 'No declared dependencies.';
---

<systems-constellation class="constellation-wrap">
  <p class="constellation-instructions">Explore a system: hover a node or focus a button to preview. Tap or press Enter / Space to select; select it again, use Clear selection, or press Escape to clear. Arrows in the details show each declared relationship’s direction.</p>
  <div class="constellation-scroll" tabindex="0" role="region" aria-label="System graph; scroll horizontally on small screens. Equivalent system controls follow.">
  <div class="constellation-stage">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    height="100%"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    role="presentation"
    class="constellation"
  >
    <defs>
      <!-- Soft glow for nodes -->
      <radialGradient id="con-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%"   stop-color="#B4D2DE" stop-opacity="1"   />
        <stop offset="40%"  stop-color="#8FB3C4" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#8FB3C4" stop-opacity="0"   />
      </radialGradient>
      <!-- Travelling pulse along an edge -->
      <linearGradient id="con-pulse" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%"  stop-color="#8FB3C4" stop-opacity="0"   />
        <stop offset="50%" stop-color="#B4D2DE" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#8FB3C4" stop-opacity="0"  />
      </linearGradient>
    </defs>

    <!-- Edges -->
    <g class="constellation-edges">
      {edges.map((e) => {
        const a = posById[e.from];
        const b = posById[e.to];
        if (!a || !b) return null;
        return (
          <line
            class="constellation-edge"
            data-from={e.from}
            data-to={e.to}
            x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            stroke="var(--signal-line)"
            stroke-width="1"
            opacity="0.55"
          />
        );
      })}
    </g>

    <!-- Nodes (background glow + shield + label) -->
    <g class="constellation-nodes">
      {nodes.map((n) => (
        <g
          class="constellation-node"
          data-id={n.id}
          data-name={n.name}
          data-tagline={n.tagline}
          data-stat={n.stat}
          transform={`translate(${n.x}, ${n.y})`}
        >
          <!-- ambient glow halo -->
          <circle r="34" fill="transparent" />
          <circle r="28" fill="url(#con-glow)" opacity="0.55" class="constellation-glow" />

          <!-- shield outline echoing the brand mark — simplified -->
          <g class="constellation-shield">
            <!-- left half stroke -->
            <path d="M -12 -10 L -12 4 L 0 14 L 0 -10 L -12 -10" fill="none"
                  stroke="#8FB3C4" stroke-width="1.5" stroke-linejoin="round" />
            <!-- right half stroke -->
            <path d="M 0 -10 L 0 14 L 12 4 L 12 -10 L 0 -10" fill="none"
                  stroke="#8FB3C4" stroke-width="1.5" stroke-linejoin="round" />
            <!-- accent block in the upper right (matches brand logo) -->
            <rect x="4" y="-12" width="10" height="4" fill="#4a6e7d" opacity="0.85" />
          </g>

          <!-- name label -->
          <text y="40" text-anchor="middle"
                font-family="Archivo, system-ui, sans-serif"
                font-size="13" font-weight="800"
                fill="#E8ECEE"
                style="font-variation-settings: 'wdth' 125;">
            {n.name}
          </text>
          <text y="56" text-anchor="middle"
                font-family="IBM Plex Mono, ui-monospace, monospace"
                font-size="8.5" letter-spacing="0.15em"
                fill="#7E8B96">
            {n.stat}
          </text>
        </g>
      ))}
    </g>
  </svg>
  </div>
  </div>

  <div class="constellation-controls" role="group" aria-label="Explore system dependencies">
    {nodes.map((n) => (
      <button type="button" data-system={n.id} data-name={n.name}
        data-tagline={`${n.tagline} · ${n.stat}`} data-relationships={relationships(n.id)}
        aria-pressed="false">{n.name}</button>
    ))}
    <button type="button" data-clear>Clear selection</button>
  </div>
  <div class="constellation-hud" role="status" aria-live="polite" aria-atomic="true">
    <strong data-hud-name>Explore a system</strong>
    <p data-hud-tagline>{nodes.length} systems · {edges.length} declared dependencies</p>
    <p data-hud-relationships>Select a system to read its relationships.</p>
  </div>
</systems-constellation>

<style>
  .constellation-wrap {
    display: block;
    position: relative;
    width: 100%;
    min-width: 0;
  }
  .constellation-scroll { overflow-x: auto; }
  .constellation-stage {
    min-width: 720px;
    aspect-ratio: 1200 / 580;
  }
  .constellation-instructions {
    color: var(--text-2, #b8c2cb);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .constellation-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .constellation-controls button {
    min-height: 44px;
    padding: 0.6rem 0.85rem;
    border: 1px solid #668696;
    border-radius: 4px;
    background: var(--bg-inset, #050b18);
    color: #e8ecee;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .constellation-controls button[aria-pressed="true"] {
    background: #b4d2de;
    color: #050b18;
    border-color: #b4d2de;
  }
  .constellation-controls button:focus-visible,
  .constellation-scroll:focus-visible {
    outline: 3px solid #b4d2de;
    outline-offset: 3px;
  }
  .constellation {
    width: 100%;
    height: 100%;
    display: block;
  }

  .constellation-edge {
    transition: stroke 320ms var(--ease-out, ease-out), opacity 320ms var(--ease-out, ease-out), stroke-width 320ms var(--ease-out, ease-out);
  }

  .constellation-node {
    cursor: pointer;
    transition: opacity 320ms var(--ease-out, ease-out);
  }
  .constellation-glow {
    transition: opacity 320ms var(--ease-out, ease-out), r 320ms var(--ease-out, ease-out);
    animation: con-glow-pulse 6s ease-in-out infinite;
  }
  @keyframes con-glow-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 0.85; }
  }
  .constellation-shield path,
  .constellation-shield rect {
    transition: stroke 320ms var(--ease-out, ease-out), fill 320ms var(--ease-out, ease-out);
  }

  /* HUD */
  .constellation-hud {
    position: relative;
    min-height: 10rem;
    padding: 1rem 0;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    color: #b8c2cb;
    background: linear-gradient(to top, var(--bg-inset) 0%, rgba(5,11,24,0) 100%);
  }
  .constellation-hud p { margin: 0.5rem 0 0; }
  .constellation-hud [data-hud-name] {
    color: var(--signal-text);
  }

  /* Hover dim of non-related nodes */
  .constellation[data-active] .constellation-node:not([data-active]) {
    opacity: 0.28;
  }
  .constellation[data-active] .constellation-edge:not([data-active]) {
    opacity: 0.08;
  }
  .constellation[data-active] .constellation-edge[data-active] {
    stroke: var(--signal-text);
    stroke-width: 1.5;
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-glow { animation: none; }
  }
  @media (max-width: 720px) {
    .constellation-scroll {
      position: relative;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      scrollbar-color: var(--signal-line) var(--bg-inset);
      scrollbar-width: thin;
    }
    .constellation-scroll::after {
      content: 'SWIPE TO EXPLORE GRAPH  →';
      position: sticky;
      left: 0;
      bottom: 0;
      display: block;
      width: max-content;
      margin: 0 0 .5rem .75rem;
      padding: .3rem .5rem;
      color: var(--signal-text);
      background: var(--bg-inset);
      border: 1px solid var(--signal-line);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: .13em;
    }
    .constellation-instructions { margin-bottom: var(--s-3); }
  }

</style>

<script>
  // Custom-element lifecycle scopes every listener to this instance and removes
  // them on Astro swaps. Reconnecting the same element is safe.
  class SystemsConstellation extends HTMLElement {
   controller;
   connectedCallback() {
    this.controller?.abort();
    this.controller = new AbortController();
    const { signal } = this.controller;
    const svg = this.querySelector('.constellation');
    if (!svg) return;
    const nodes = svg.querySelectorAll('.constellation-node');
    const edges = svg.querySelectorAll('.constellation-edge');
    const controls = this.querySelectorAll('[data-system]');
    const hudName = this.querySelector('[data-hud-name]');
    const hudTag = this.querySelector('[data-hud-tagline]');
    const hudRelationships = this.querySelector('[data-hud-relationships]');
    let selected = null;
    let focused = null;
    let hovered = null;

    function render() {
      const id = hovered ?? focused ?? selected;
      controls.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.system === selected)));
      if (!id) {
        svg.removeAttribute('data-active');
        nodes.forEach((n) => n.removeAttribute('data-active'));
        edges.forEach((e) => e.removeAttribute('data-active'));
        hudName.textContent = 'Explore a system';
        hudTag.textContent = `${nodes.length} systems · ${edges.length} declared dependencies`;
        hudRelationships.textContent = 'Select a system to read its relationships.';
        return;
      }
      svg.setAttribute('data-active', id);
      nodes.forEach((n) => {
        const nid = n.getAttribute('data-id');
        // mark the focused node + any node connected to it as active
        const isConnected = Array.from(edges).some((e) =>
          (e.getAttribute('data-from') === id && e.getAttribute('data-to') === nid) ||
          (e.getAttribute('data-to')   === id && e.getAttribute('data-from') === nid)
        );
        if (nid === id || isConnected) {
          n.setAttribute('data-active', 'true');
        } else {
          n.removeAttribute('data-active');
        }
      });
      edges.forEach((e) => {
        const connectsFocus = e.getAttribute('data-from') === id || e.getAttribute('data-to') === id;
        if (connectsFocus) {
          e.setAttribute('data-active', 'true');
        } else {
          e.removeAttribute('data-active');
        }
      });
      const button = Array.from(controls).find((button) => button.dataset.system === id);
      if (button) {
        hudName.textContent = button.dataset.name;
        hudTag.textContent = button.dataset.tagline;
        hudRelationships.textContent = button.dataset.relationships;
      }
    }

    function clear() {
      selected = focused = hovered = null;
      render();
    }
    function select(id) {
      selected = selected === id ? null : id;
      focused = hovered = null;
      render();
    }
    controls.forEach((button) => {
      button.addEventListener('focus', () => { focused = button.dataset.system; render(); }, { signal });
      button.addEventListener('blur', () => { focused = null; render(); }, { signal });
      button.addEventListener('click', () => select(button.dataset.system), { signal });
    });
    nodes.forEach((n) => {
      const id = n.dataset.id;
      n.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') { hovered = id; render(); }
      }, { signal });
      n.addEventListener('pointerleave', () => { hovered = null; render(); }, { signal });
      n.addEventListener('click', () => select(id), { signal });
    });
    this.querySelector('[data-clear]')?.addEventListener('click', clear, { signal });
    this.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { clear(); event.preventDefault(); }
    }, { signal });
    render();
   }
   disconnectedCallback() { this.controller?.abort(); }
  }
  if (!customElements.get('systems-constellation')) {
    customElements.define('systems-constellation', SystemsConstellation);
  }
</script>
