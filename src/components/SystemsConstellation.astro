---
/**
 * SystemsConstellation — the 10-system dependency graph.
 *
 * Wow moment #2 of the homepage. Mycelium's hero is wow #1; this is the
 * "and these other nine are real too" moment. Each system is a navy-shielded
 * node; edges are declared dependencies (Signet → Auspex, Pyros → RigRun,
 * HawkStack → Meridian, etc.).
 *
 * Hover any node → its outgoing edges brighten, non-connected nodes
 * desaturate, and the system's tagline + version line appears in the
 * telemetry strip below the graph.
 *
 * Pure SVG + CSS + ~30 LOC of vanilla JS. No R3F, no bundle bloat.
 * Reduced-motion: hover interactions still work; only the ambient pulse
 * animations are stilled.
 */
import graph from '../data/system-graph.json';

const W = 1200;
const H = 520;
const nodes = graph.nodes;
const edges = graph.edges;

// Pre-compute a lookup so we can pull node positions inline.
const posById = Object.fromEntries(nodes.map((n) => [n.id, n]));
---

<div class="constellation-wrap">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    height="100%"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    role="presentation"
    class="constellation"
  >
    <defs>
      <!-- Soft glow for nodes -->
      <radialGradient id="con-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%"   stop-color="#B4D2DE" stop-opacity="1"   />
        <stop offset="40%"  stop-color="#8FB3C4" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#8FB3C4" stop-opacity="0"   />
      </radialGradient>
      <!-- Travelling pulse along an edge -->
      <linearGradient id="con-pulse" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%"  stop-color="#8FB3C4" stop-opacity="0"   />
        <stop offset="50%" stop-color="#B4D2DE" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#8FB3C4" stop-opacity="0"  />
      </linearGradient>
    </defs>

    <!-- Edges -->
    <g class="constellation-edges">
      {edges.map((e) => {
        const a = posById[e.from];
        const b = posById[e.to];
        if (!a || !b) return null;
        return (
          <line
            class="constellation-edge"
            data-from={e.from}
            data-to={e.to}
            x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            stroke="var(--signal-line)"
            stroke-width="1"
            opacity="0.55"
          />
        );
      })}
    </g>

    <!-- Nodes (background glow + shield + label) -->
    <g class="constellation-nodes">
      {nodes.map((n) => (
        <g
          class="constellation-node"
          data-id={n.id}
          data-name={n.name}
          data-tagline={n.tagline}
          data-stat={n.stat}
          transform={`translate(${n.x}, ${n.y})`}
        >
          <!-- ambient glow halo -->
          <circle r="28" fill="url(#con-glow)" opacity="0.55" class="constellation-glow" />

          <!-- shield outline echoing the brand mark — simplified -->
          <g class="constellation-shield">
            <!-- left half stroke -->
            <path d="M -12 -10 L -12 4 L 0 14 L 0 -10 L -12 -10" fill="none"
                  stroke="#8FB3C4" stroke-width="1.5" stroke-linejoin="round" />
            <!-- right half stroke -->
            <path d="M 0 -10 L 0 14 L 12 4 L 12 -10 L 0 -10" fill="none"
                  stroke="#8FB3C4" stroke-width="1.5" stroke-linejoin="round" />
            <!-- accent block in the upper right (matches brand logo) -->
            <rect x="4" y="-12" width="10" height="4" fill="#4a6e7d" opacity="0.85" />
          </g>

          <!-- name label -->
          <text y="40" text-anchor="middle"
                font-family="Archivo, system-ui, sans-serif"
                font-size="13" font-weight="800"
                fill="#E8ECEE"
                style="font-variation-settings: 'wdth' 125;">
            {n.name}
          </text>
          <text y="56" text-anchor="middle"
                font-family="IBM Plex Mono, ui-monospace, monospace"
                font-size="8.5" letter-spacing="0.15em"
                fill="#7E8B96">
            {n.stat}
          </text>
        </g>
      ))}
    </g>
  </svg>

  <!-- Telemetry readout — updated on hover -->
  <div class="constellation-hud" aria-live="polite">
    <span data-hud-name>HOVER A NODE</span>
    <span data-hud-tagline> · 10 SYSTEMS · 12 DECLARED DEPENDENCIES</span>
  </div>
</div>

<style>
  .constellation-wrap {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 580;
  }
  .constellation {
    width: 100%;
    height: 100%;
    display: block;
  }

  .constellation-edge {
    transition: stroke 320ms var(--ease-out, ease-out), opacity 320ms var(--ease-out, ease-out), stroke-width 320ms var(--ease-out, ease-out);
  }

  .constellation-node {
    cursor: default;
    transition: opacity 320ms var(--ease-out, ease-out);
  }
  .constellation-glow {
    transition: opacity 320ms var(--ease-out, ease-out), r 320ms var(--ease-out, ease-out);
    animation: con-glow-pulse 6s ease-in-out infinite;
  }
  @keyframes con-glow-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 0.85; }
  }
  .constellation-shield path,
  .constellation-shield rect {
    transition: stroke 320ms var(--ease-out, ease-out), fill 320ms var(--ease-out, ease-out);
  }

  /* HUD */
  .constellation-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--s-3) var(--s-4);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: var(--step--1);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-3);
    background: linear-gradient(to top, var(--bg-inset) 0%, rgba(5,11,24,0) 100%);
    pointer-events: none;
  }
  .constellation-hud [data-hud-name] {
    color: var(--signal-text);
  }

  /* Hover dim of non-related nodes */
  .constellation[data-active] .constellation-node:not([data-active]) {
    opacity: 0.28;
  }
  .constellation[data-active] .constellation-edge:not([data-active]) {
    opacity: 0.08;
  }
  .constellation[data-active] .constellation-edge[data-active] {
    stroke: var(--signal-text);
    stroke-width: 1.5;
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-glow { animation: none; }
  }

  @media (max-width: 720px) {
    .constellation-hud { font-size: 10px; }
  }
</style>

<script>
  // Wire up hover interactions. Re-runs on astro:page-load so view transitions
  // don't break the listeners.
  function bindConstellation() {
    const svg = document.querySelector('.constellation');
    if (!svg) return;
    const nodes = svg.querySelectorAll('.constellation-node');
    const edges = svg.querySelectorAll('.constellation-edge');
    const hudName = document.querySelector('.constellation-hud [data-hud-name]');
    const hudTag  = document.querySelector('.constellation-hud [data-hud-tagline]');

    function setActive(id) {
      svg.setAttribute('data-active', id);
      nodes.forEach((n) => {
        const nid = n.getAttribute('data-id');
        // mark the focused node + any node connected to it as active
        const isConnected = Array.from(edges).some((e) =>
          (e.getAttribute('data-from') === id && e.getAttribute('data-to') === nid) ||
          (e.getAttribute('data-to')   === id && e.getAttribute('data-from') === nid)
        );
        if (nid === id || isConnected) {
          n.setAttribute('data-active', 'true');
        } else {
          n.removeAttribute('data-active');
        }
      });
      edges.forEach((e) => {
        const connectsFocus = e.getAttribute('data-from') === id || e.getAttribute('data-to') === id;
        if (connectsFocus) {
          e.setAttribute('data-active', 'true');
        } else {
          e.removeAttribute('data-active');
        }
      });
      const node = svg.querySelector(`.constellation-node[data-id="${id}"]`);
      if (node && hudName && hudTag) {
        const name    = node.getAttribute('data-name') || '';
        const tagline = node.getAttribute('data-tagline') || '';
        const stat    = node.getAttribute('data-stat') || '';
        hudName.textContent = `// ${name.toUpperCase()}`;
        hudTag.textContent  = ` · ${tagline.toUpperCase()} · ${stat.toUpperCase()}`;
      }
    }

    function clearActive() {
      svg.removeAttribute('data-active');
      nodes.forEach((n) => n.removeAttribute('data-active'));
      edges.forEach((e) => e.removeAttribute('data-active'));
      if (hudName) hudName.textContent = '// HOVER A NODE';
      if (hudTag)  hudTag.textContent  = ' · 10 SYSTEMS · 12 DECLARED DEPENDENCIES';
    }

    nodes.forEach((n) => {
      const id = n.getAttribute('data-id');
      n.style.pointerEvents = 'all';
      n.addEventListener('mouseenter', () => setActive(id));
      n.addEventListener('mouseleave', clearActive);
      n.addEventListener('focus', () => setActive(id));
      n.addEventListener('blur', clearActive);
    });
  }

  bindConstellation();
  document.addEventListener('astro:page-load', bindConstellation);
</script>
