---
/**
 * FounderCard — surface the asymmetric advantage above-the-fold-of-/about.
 *
 * Most B2B sites bury founder context in /about. Thornveil's unique wedge
 * IS the founder (active-duty USMC, 1.3M LOC solo, DD-214 countdown). The
 * research showed Cursor leads with Karpathy / Huang by name. Thornveil
 * doesn't have third-party celebrities yet — but the founder bio is the
 * strongest social proof available today.
 */
import metrics from '../data/metrics.json';
const m = metrics;
function daysUntil(iso) {
  const d = (new Date(iso).getTime() - Date.now()) / 86400000;
  return Math.max(0, Math.ceil(d));
}
const dd214Days = daysUntil(m.company.directContractsOpenISO);
---

<section class="tv-section pt-0" style="background: var(--bg);">
  <div class="tv-container max-w-5xl">
    <div class="tv-tile founder-card reveal">
      <div class="founder-grid">
        <!-- Sigil block — patch-grade composition. Echoes uniform-tape rank
             insignia + monogram + countdown. Stands in for a photo until one
             is shot. -->
        <div class="founder-sigil" aria-hidden="true">
          <!-- top chevron bar -->
          <div class="founder-sigil-chevron">
            <span></span><span></span><span></span>
          </div>
          <div class="founder-monogram-wrap">
            <div class="founder-monogram">JM</div>
            <div class="founder-monogram-frame" aria-hidden="true"></div>
          </div>
          <div class="founder-sigil-meta">
            <div class="founder-sigil-line">
              <span class="founder-sigil-tag">RANK</span>
              <span>STAFF SGT · USMC</span>
            </div>
            <div class="founder-sigil-line">
              <span class="founder-sigil-tag">DISC</span>
              <span>SIGINT · TS/SCI</span>
            </div>
            <div class="founder-sigil-line founder-sigil-line--accent">
              <span class="founder-sigil-tag">DD-214</span>
              <span class="tabular">T −{dd214Days}d</span>
            </div>
          </div>
        </div>

        <!-- Founder bio + wedge -->
        <div class="founder-body">
          <p class="font-mono text-step--1 tracking-[0.18em] uppercase text-signal-text mb-s-3">
            The founder
          </p>
          <h2 class="text-step-3 mb-s-4" style="font-variation-settings: 'wdth' 125; line-height: 1.06;">
            Jesse Morgan — eight years SIGINT, ten engineering systems, one company.
          </h2>
          <div class="founder-bullets">
            <div class="founder-bullet">
              <span class="founder-bullet-tag">SERVICE</span>
              <span>USMC Staff Sergeant · 8+ years · 6 countries deployed · national-level intelligence reporting</span>
            </div>
            <div class="founder-bullet">
              <span class="founder-bullet-tag">DISCIPLINE</span>
              <span>Signals Intelligence · TS/SCI · BA Arabic, Defense Language Institute</span>
            </div>
            <div class="founder-bullet">
              <span class="founder-bullet-tag">BUILD</span>
              <span>Started Thornveil January 2026 · {m.portfolio.totalSystems} engineering systems by May 2026 · two Apache-2.0 OSS releases</span>
            </div>
            <div class="founder-bullet">
              <span class="founder-bullet-tag">POSTURE</span>
              <span>Evaluation engagements active. Direct contracts open {m.company.directContractsOpen}.</span>
            </div>
          </div>
          <div class="mt-s-5 flex flex-wrap gap-s-3">
            <a href="/about" class="tv-nav-link">Full founder narrative →</a>
            <a href="https://github.com/thornveil-ai" target="_blank" rel="noopener" class="tv-nav-link">Verify the work ↗</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-card {
    padding: var(--s-7);
  }
  .founder-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--s-7);
    align-items: start;
  }
  .founder-sigil {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(143,179,196,0.10), transparent 70%),
      var(--bg-inset);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    position: relative;
  }
  /* Top-left + top-right corner ticks — instrument-bezel detail */
  .founder-sigil::before,
  .founder-sigil::after {
    content: '';
    position: absolute;
    top: 6px;
    width: 10px;
    height: 10px;
    pointer-events: none;
  }
  .founder-sigil::before {
    left: 6px;
    border-top: 1px solid var(--signal-line);
    border-left: 1px solid var(--signal-line);
  }
  .founder-sigil::after {
    right: 6px;
    border-top: 1px solid var(--signal-line);
    border-right: 1px solid var(--signal-line);
  }

  /* Chevron strip — three rank-style bars in steel teal */
  .founder-sigil-chevron {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: var(--s-2);
  }
  .founder-sigil-chevron span {
    width: 22px;
    height: 6px;
    background: var(--signal-line);
    clip-path: polygon(0 0, 100% 0, calc(100% - 4px) 100%, 4px 100%);
  }
  .founder-sigil-chevron span:nth-child(2) {
    background: var(--signal-text);
  }

  /* Monogram + frame */
  .founder-monogram-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--s-4);
  }
  .founder-monogram {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 125;
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--signal-text);
    line-height: 1;
    text-shadow: 0 0 24px rgba(143, 179, 196, 0.35);
    position: relative;
    z-index: 1;
  }
  .founder-monogram-frame {
    position: absolute;
    inset: 6px 14px;
    border: 1px solid var(--signal-line);
    border-radius: 2px;
    opacity: 0.5;
  }
  .founder-monogram-frame::before,
  .founder-monogram-frame::after {
    content: '';
    position: absolute;
    background: var(--signal-text);
  }
  .founder-monogram-frame::before {
    top: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 18px;
    height: 1px;
  }
  .founder-monogram-frame::after {
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 18px;
    height: 1px;
  }

  .founder-sigil-meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-2);
    line-height: 1.4;
  }
  .founder-sigil-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
    padding: 4px 0;
    border-bottom: 1px dotted var(--line);
  }
  .founder-sigil-line:last-child { border-bottom: 0; }
  .founder-sigil-tag {
    color: var(--text-3);
    font-size: 8.5px;
  }
  .founder-sigil-line--accent {
    color: var(--signal-text);
  }
  .founder-sigil-line--accent .founder-sigil-tag {
    color: var(--signal-text);
  }
  .founder-body {
    min-width: 0;
  }
  .founder-bullets {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .founder-bullet {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
    font-size: var(--step-0);
  }
  .founder-bullet:last-child { border-bottom: 0; }
  .founder-bullet-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  @media (max-width: 820px) {
    .founder-grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .founder-sigil {
      max-width: 280px;
    }
    .founder-bullet {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
